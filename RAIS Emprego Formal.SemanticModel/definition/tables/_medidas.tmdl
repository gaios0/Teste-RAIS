			VAR N = [Ind_Total_Divisoes]
			VAR Afl = [Ind_Valor_AFL]
			VAR Comp = [Ind_Valor_Comp]
			VAR L1 = IF(ISBLANK(Pos), "O AFL não tem dados deste indicador", "O AFL é o " & Pos & "º entre " & N & " divisões em " & [Ind_Rotulo])
			VAR L2 = IF(ISBLANK(Pos), "", "AFL " & IF(ISBLANK(Afl), "—", FORMAT(Afl, "0.0%", "pt-BR")) & " × Comparáveis " & IF(ISBLANK(Comp), "—", FORMAT(Comp, "0.0%", "pt-BR")) & " · participação de " & [Ind_Rotulo] & " em cada divisão, " & [Ind_Ano] & " · só divisões com 50 mil empregos ou mais · troque o indicador nos botões")
			RETURN
