	/// Texto do recorte de setor da página Todos os setores: divisão(ões) escolhida(s), comparáveis, demais setores ou todos os setores.
	measure Setor_Emp_Total =
			VAR NDiv = COUNTROWS(VALUES(D_Cnae[nm_divisao]))
			RETURN IF(ISFILTERED(D_Cnae[nm_divisao]) && NDiv < COUNTROWS(ALL(D_Cnae[nm_divisao])), IF(NDiv = 1, SELECTEDVALUE(D_Cnae[nm_divisao]), NDiv & " divisões"),
			    IF(ISFILTERED(D_Comparavel[comparavel_AFL_rotulo]) && COUNTROWS(VALUES(D_Comparavel[comparavel_AFL_rotulo])) = 1, LOWER(SELECTEDVALUE(D_Comparavel[comparavel_AFL_rotulo])), "todos os setores"))
		isHidden
		displayFolder: Empregos\Apoio
		lineageTag: 77702f48-1aaa-4436-a85e-8a7ca9483fc5

	/// Linha de contexto da página Empregos · Todos os setores.
	measure Contexto_Emp_Total =
			VAR A = [Ano_Ref]
			VAR TemUF = ISFILTERED(D_UF[uf])
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Local = IF(NOT TemUF || NUF = COUNTROWS(ALL(D_UF[uf])), "Brasil", IF(NUF = 1, SELECTEDVALUE(D_UF[estado]), NUF & " UFs"))
			VAR Sexo = IF(ISFILTERED(D_Sexo[sexo]), CONCATENATEX(VALUES(D_Sexo[sexo]), D_Sexo[sexo], ", "), "")
			VAR Esc = IF(ISFILTERED(D_Escolaridade[escolaridade_agrupada]), CONCATENATEX(VALUES(D_Escolaridade[escolaridade_agrupada]), D_Escolaridade[escolaridade_agrupada], ", "), "")
			VAR Raca = IF(ISFILTERED(D_Raca[raca_cor]), CONCATENATEX(VALUES(D_Raca[raca_cor]), D_Raca[raca_cor], ", "), "")
			VAR Setor = [Setor_Emp_Total]
			VAR Partes = FILTER(UNION(ROW("@o", 1, "@t", "31/12/" & A), ROW("@o", 2, "@t", Local), ROW("@o", 3, "@t", Setor), ROW("@o", 4, "@t", Sexo),
			    ROW("@o", 5, "@t", Esc), ROW("@o", 6, "@t", Raca), ROW("@o", 7, "@t", "RAIS (" & IF(A >= 2022, "eSocial", "declaratória") & ")")), NOT ISBLANK([@t]) && [@t] <> "")
			VAR Texto = CONCATENATEX(Partes, [@t], " · ", [@o], ASC)
			RETURN IF(ISBLANK(A), "", Texto)
		isHidden
		displayFolder: Empregos\Apoio
		lineageTag: bef76d55-d439-43f0-8c0a-4ed79a97f8d8

	/// Linha de contexto da página Empregos · AFL.
	measure Contexto_Emp_AFL =
			VAR A = [Ano_Ref]
			VAR TemUF = ISFILTERED(D_UF[uf])
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Local = IF(NOT TemUF || NUF = COUNTROWS(ALL(D_UF[uf])), "Brasil", IF(NUF = 1, SELECTEDVALUE(D_UF[estado]), NUF & " UFs"))
			VAR Sexo = IF(ISFILTERED(D_Sexo[sexo]), CONCATENATEX(VALUES(D_Sexo[sexo]), D_Sexo[sexo], ", "), "")
			VAR Esc = IF(ISFILTERED(D_Escolaridade[escolaridade_agrupada]), CONCATENATEX(VALUES(D_Escolaridade[escolaridade_agrupada]), D_Escolaridade[escolaridade_agrupada], ", "), "")
			VAR Raca = IF(ISFILTERED(D_Raca[raca_cor]), CONCATENATEX(VALUES(D_Raca[raca_cor]), D_Raca[raca_cor], ", "), "")
			VAR Setor = IF(ISFILTERED(D_AflAtividade[nome]) && COUNTROWS(VALUES(D_AflAtividade[nome])) < COUNTROWS(ALL(D_AflAtividade[nome])), CONCATENATEX(VALUES(D_AflAtividade[nome]), D_AflAtividade[nome], ", "), "alimentação fora do lar (AFL)")
			VAR Partes = FILTER(UNION(ROW("@o", 1, "@t", "31/12/" & A), ROW("@o", 2, "@t", Local), ROW("@o", 3, "@t", Setor), ROW("@o", 4, "@t", Sexo),
			    ROW("@o", 5, "@t", Esc), ROW("@o", 6, "@t", Raca), ROW("@o", 7, "@t", "RAIS (" & IF(A >= 2022, "eSocial", "declaratória") & ")")), NOT ISBLANK([@t]) && [@t] <> "")
			VAR Texto = CONCATENATEX(Partes, [@t], " · ", [@o], ASC)
			RETURN IF(ISBLANK(A), "", Texto)
		isHidden
		displayFolder: Empregos\Apoio
		lineageTag: 237d2889-3578-4247-9d4c-2c7af53ba071

	/// Manchete da página Empregos · Todos os setores.
	measure Manchete_Emp_Total_HTML =
			VAR A = [Ano_Ref]
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Prep = IF(NOT ISFILTERED(D_UF[uf]) || NUF = COUNTROWS(ALL(D_UF[uf])), "No Brasil", IF(NUF = 1, "Em " & SELECTEDVALUE(D_UF[estado]), "Nas " & NUF & " UFs escolhidas"))
			VAR Valor = [Empregos_Ref]
			VAR Variacao = [Empregos_Var]
			VAR VarPct = [Empregos_Var_Pct]
			VAR Seq = [Emp_Sequencia_Altas_AFL]
			VAR Contexto = [Contexto_Emp_Total]
			VAR Pos = [Emp_Posicao_AFL_Divisao]
			VAR Divs = [Emp_Total_Divisoes]
			VAR SetorTxt = [Setor_Emp_Total]
			VAR Texto = Prep & ", " & IF(SetorTxt = "todos os setores", "o emprego formal", "o emprego em " & SetorTxt) & " fechou " & A & " com " & FORMAT(Valor, "#,0", "pt-BR") & " vínculos" & IF(ISBLANK(Pos) || SetorTxt <> "todos os setores", "", "; o AFL é a " & Pos & "ª maior divisão entre " & Divs)
			VAR Valido = NOT ISBLANK(A) && NOT ISBLANK(Valor)
			RETURN
			    IF(NOT Valido,
			        "<div role='text' style='width:100%;height:118px;font-family:Segoe UI,Arial,sans-serif;font-size:24px;color:#434446;'>Não há dados para os filtros selecionados.</div>",
			        "<div role='group' aria-label='Resumo do emprego formal' style='width:100%;height:118px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			            & "<div style='height:48px;display:flex;align-items:center;white-space:nowrap;overflow:hidden;'><span style='min-width:0;font-size:36px;line-height:42px;font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Texto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span></div>"
			            & "<div style='height:30px;margin:4px 0 0;font-size:24px;line-height:30px;color:#434446;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Contexto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>"
			        & "</div>")
		displayFolder: HTML\Empregos
		lineageTag: 51e632d8-9028-4e8b-bfa1-6e2097ea99cb

	/// Manchete da página Empregos · AFL.
	measure Manchete_Emp_AFL_HTML =
			VAR A = [Ano_Ref]
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Prep = IF(NOT ISFILTERED(D_UF[uf]) || NUF = COUNTROWS(ALL(D_UF[uf])), "No Brasil", IF(NUF = 1, "Em " & SELECTEDVALUE(D_UF[estado]), "Nas " & NUF & " UFs escolhidas"))
			VAR Valor = [Empregos_Ref]
			VAR Variacao = [Empregos_Var]
			VAR VarPct = [Empregos_Var_Pct]
			VAR Seq = [Emp_Sequencia_Altas_AFL]
			VAR Contexto = [Contexto_Emp_AFL]
			VAR Fecho = SWITCH(TRUE(), ISBLANK(Variacao), IF(A = 2022, "primeiro ano da fonte eSocial", "primeiro ano da série"),
			    Variacao > 0, IF(Seq >= 2, Seq & "ª alta seguida", "alta de " & IF(ISBLANK(VarPct), "—", FORMAT(VarPct, "0.0%", "pt-BR"))), Variacao < 0, "queda de " & IF(ISBLANK(ABS(VarPct)), "—", FORMAT(ABS(VarPct), "0.0%", "pt-BR")) & " sobre " & (A - 1), "estável")
			VAR Texto = Prep & ", o AFL fechou " & A & " com " & FORMAT(Valor, "#,0", "pt-BR") & " empregos formais: " & Fecho
			VAR Valido = NOT ISBLANK(A) && NOT ISBLANK(Valor)
			RETURN
			    IF(NOT Valido,
			        "<div role='text' style='width:100%;height:118px;font-family:Segoe UI,Arial,sans-serif;font-size:24px;color:#434446;'>Não há dados para os filtros selecionados.</div>",
			        "<div role='group' aria-label='Resumo do emprego formal' style='width:100%;height:118px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			            & "<div style='height:48px;display:flex;align-items:center;white-space:nowrap;overflow:hidden;'><span style='min-width:0;font-size:36px;line-height:42px;font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Texto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span></div>"
			            & "<div style='height:30px;margin:4px 0 0;font-size:24px;line-height:30px;color:#434446;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Contexto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>"
			        & "</div>")
		displayFolder: HTML\Empregos
		lineageTag: 5cf4bb1f-0638-4334-8ae9-a731dd810839

	/// Título do gráfico de série (índice): crescimento desde o início do trecho, AFL × comparáveis.
	measure Titulo_Emp_Serie_HTML =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Afl = [Empregos_Ref_AFL]
			VAR Comp = [Empregos_Ref_Comparavel]
			VAR AflI = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			VAR CompI = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			VAR CAfl = DIVIDE(Afl, AflI) - 1
			VAR CComp = DIVIDE(Comp, CompI) - 1
			VAR Afl19 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2019)
			VAR Afl20 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2020)
			VAR Comp19 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2019)
			VAR Comp20 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2020)
			VAR L1 = IF(ISBLANK(A), "Sem dados para os filtros escolhidos", IF(A <= I, I & " é o primeiro ano do trecho: ainda não há crescimento a comparar",
			    "Desde " & I & ", o emprego do AFL cresceu " & IF(ISBLANK(CAfl), "—", FORMAT(CAfl, "0.0%", "pt-BR")) & " e o dos comparáveis, " & IF(ISBLANK(CComp), "—", FORMAT(CComp, "0.0%", "pt-BR"))))
			VAR L2 = IF(ISBLANK(A), "", IF(A >= 2022, "Índice de empregos em 31/12, base 100 = 31/12/" & I & ". 2021 e os anos anteriores ficam no trecho anterior (nova fonte: eSocial)",
			    "Índice de empregos em 31/12, base 100 = 31/12/" & I & IF(Afl19 > 0 && Afl20 > 0 && Comp19 > 0, ". Em 2020 o AFL perdeu " & IF(ISBLANK(ABS(DIVIDE(Afl20, Afl19) - 1)), "—", FORMAT(ABS(DIVIDE(Afl20, Afl19) - 1), "0.0%", "pt-BR")) & " dos empregos; os comparáveis, " & IF(ISBLANK(ABS(DIVIDE(Comp20, Comp19) - 1)), "—", FORMAT(ABS(DIVIDE(Comp20, Comp19) - 1), "0.0%", "pt-BR")), "")))
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#F58220" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Empregos\Títulos
		lineageTag: c57a3a11-7a7a-459f-a275-33024d92d08d

	/// Título do gráfico de série (página Todos os setores): AFL, comparáveis e a seleção atual (mercado ou setores filtrados).
	measure Titulo_Emp_SerieTotal_HTML =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Afl = [Empregos_Ref_AFL]
			VAR Comp = [Empregos_Ref_Comparavel]
			VAR AflI = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			VAR CompI = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			VAR CAfl = DIVIDE(Afl, AflI) - 1
			VAR CComp = DIVIDE(Comp, CompI) - 1
			VAR Afl19 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2019)
			VAR Afl20 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2020)
			VAR Comp19 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2019)
			VAR Comp20 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2020)
			VAR SelA = CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR SelI = CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			VAR CSel = DIVIDE(SelA, SelI) - 1
			VAR SetorSel = [Setor_Emp_Total]
			VAR NomeSel = IF(SetorSel = "todos os setores", "mercado formal", SetorSel)
			VAR L1 = IF(ISBLANK(A), "Sem dados para os filtros escolhidos", IF(A <= I, I & " é o primeiro ano do trecho: ainda não há crescimento a comparar",
			    "Desde " & I & ": AFL " & IF(ISBLANK(CAfl), "—", IF(CAfl > 0, "+", IF(CAfl < 0, "−", "")) & FORMAT(ABS(CAfl), "0.0%", "pt-BR")) & ", comparáveis " & IF(ISBLANK(CComp), "—", IF(CComp > 0, "+", IF(CComp < 0, "−", "")) & FORMAT(ABS(CComp), "0.0%", "pt-BR")) & ", " & NomeSel & " " & IF(ISBLANK(CSel), "—", IF(CSel > 0, "+", IF(CSel < 0, "−", "")) & FORMAT(ABS(CSel), "0.0%", "pt-BR"))))
			VAR L2 = IF(ISBLANK(A), "", IF(A >= 2022, "Índice de empregos em 31/12, base 100 = 31/12/" & I & ". 2021 e os anos anteriores ficam no trecho anterior (nova fonte: eSocial)",
			    "Índice de empregos em 31/12, base 100 = 31/12/" & I & IF(Afl19 > 0 && Afl20 > 0 && Comp19 > 0, ". Em 2020 o AFL perdeu " & IF(ISBLANK(ABS(DIVIDE(Afl20, Afl19) - 1)), "—", FORMAT(ABS(DIVIDE(Afl20, Afl19) - 1), "0.0%", "pt-BR")) & " dos empregos; os comparáveis, " & IF(ISBLANK(ABS(DIVIDE(Comp20, Comp19) - 1)), "—", FORMAT(ABS(DIVIDE(Comp20, Comp19) - 1), "0.0%", "pt-BR")), "")))
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#F58220" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Empregos\Títulos
		lineageTag: c0995289-cbcf-4232-bc93-50470a94f579

	/// Índice de empregos da seleção atual (todo o mercado ou os filtros de setor e divisão), trecho 2009–2021; BLANK fora do trecho.
	measure Emp_Indice_Sel_Pre =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Fim = CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR Base = CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			RETURN IF(NOT ISBLANK(A) && A < 2022 && Base > 0, DIVIDE(Fim, Base) * 100)
		formatString: 0.0
		displayFolder: Empregos\Séries
		lineageTag: 0f8f1192-2244-4f22-8981-e7f4f2ed4448

	/// Índice de empregos da seleção atual (todo o mercado ou os filtros de setor e divisão), trecho 2022 em diante; BLANK fora do trecho.
	measure Emp_Indice_Sel_Pos =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Fim = CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR Base = CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			RETURN IF(NOT ISBLANK(A) && A >= 2022 && Base > 0, DIVIDE(Fim, Base) * 100)
		formatString: 0.0
		displayFolder: Empregos\Séries
		lineageTag: 7e4ab708-eca0-4bd1-ae32-d6da3a28c813

	/// Tabela de contratos: AFL × Comparáveis, em % dos empregos de 31/12 do ano de referência (categorias exclusivas, na ordem intermitente, aprendiz, parcial, CLT, prazo determinado).
	measure Emp_Contratos_HTML =
			VAR A = [Ano_Ref]
			VAR TotA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR cltA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] <> "Sim", F_rais[modalidade_contrato] = "CLT Prazo Indeterminado")
			VAR detA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] <> "Sim", F_rais[modalidade_contrato] IN {"CLT Prazo Determinado", "Contrato por Prazo Determinado", "Temporário", "Contrato Temporário"})
			VAR interA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] = "Sim")
			VAR parcA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] = "Sim")
			VAR aprA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] = "Aprendiz")
			VAR TotC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR cltC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] <> "Sim", F_rais[modalidade_contrato] = "CLT Prazo Indeterminado")
			VAR detC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] <> "Sim", F_rais[modalidade_contrato] IN {"CLT Prazo Determinado", "Contrato por Prazo Determinado", "Temporário", "Contrato Temporário"})
			VAR interC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] = "Sim")
			VAR parcC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] = "Sim")
			VAR aprC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] = "Aprendiz")
			RETURN IF(ISBLANK(A) || TotA = 0, "<div style='font-family:Segoe UI,Arial,sans-serif;font-size:21px;color:#434446;'>Sem dados para os filtros escolhidos.</div>",
			    "<table style='width:100%;border-collapse:collapse;font-family:Segoe UI,Arial,sans-serif;font-size:21px;font-variant-numeric:tabular-nums;'><tr style='color:#434446;'><th style='text-align:left;font-weight:600;padding-bottom:6px;'>Contrato</th><th style='text-align:right;font-weight:600;color:#B86218;'>AFL</th><th style='text-align:right;font-weight:600;'>Comparáveis</th></tr>" & "<tr><td style='padding:9px 0;border-top:1px solid #E8E8E9;'>CLT por prazo indeterminado</td><td style='text-align:right;font-weight:600;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotA) || TotA = 0, "—", FORMAT(DIVIDE(cltA, TotA), "0.0%", "pt-BR")) & "</td><td style='text-align:right;color:#434446;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotC) || TotC = 0, "—", FORMAT(DIVIDE(cltC, TotC), "0.0%", "pt-BR")) & "</td></tr>" & "<tr><td style='padding:9px 0;border-top:1px solid #E8E8E9;'>Prazo determinado ou temporário</td><td style='text-align:right;font-weight:600;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotA) || TotA = 0, "—", FORMAT(DIVIDE(detA, TotA), "0.0%", "pt-BR")) & "</td><td style='text-align:right;color:#434446;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotC) || TotC = 0, "—", FORMAT(DIVIDE(detC, TotC), "0.0%", "pt-BR")) & "</td></tr>" & "<tr><td style='padding:9px 0;border-top:1px solid #E8E8E9;'>Intermitente</td><td style='text-align:right;font-weight:600;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotA) || TotA = 0, "—", FORMAT(DIVIDE(interA, TotA), "0.0%", "pt-BR")) & "</td><td style='text-align:right;color:#434446;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotC) || TotC = 0, "—", FORMAT(DIVIDE(interC, TotC), "0.0%", "pt-BR")) & "</td></tr>" & "<tr><td style='padding:9px 0;border-top:1px solid #E8E8E9;'>Parcial</td><td style='text-align:right;font-weight:600;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotA) || TotA = 0, "—", FORMAT(DIVIDE(parcA, TotA), "0.0%", "pt-BR")) & "</td><td style='text-align:right;color:#434446;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotC) || TotC = 0, "—", FORMAT(DIVIDE(parcC, TotC), "0.0%", "pt-BR")) & "</td></tr>" & "<tr><td style='padding:9px 0;border-top:1px solid #E8E8E9;'>Aprendiz</td><td style='text-align:right;font-weight:600;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotA) || TotA = 0, "—", FORMAT(DIVIDE(aprA, TotA), "0.0%", "pt-BR")) & "</td><td style='text-align:right;color:#434446;border-top:1px solid #E8E8E9;'>" & IF(ISBLANK(TotC) || TotC = 0, "—", FORMAT(DIVIDE(aprC, TotC), "0.0%", "pt-BR")) & "</td></tr>" & "</table>")
		displayFolder: HTML\Empregos
		lineageTag: 4122c6ac-6261-4b6a-a5ee-05e69fb3aec5

	/// Título do card de contratos: % de CLT por prazo indeterminado no AFL e o contraste com os comparáveis.
	measure Titulo_Emp_Contrato_HTML =
			VAR A = [Ano_Ref]
			VAR TotA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR cltA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] <> "Sim", F_rais[modalidade_contrato] = "CLT Prazo Indeterminado")
			VAR detA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] <> "Sim", F_rais[modalidade_contrato] IN {"CLT Prazo Determinado", "Contrato por Prazo Determinado", "Temporário", "Contrato Temporário"})
			VAR interA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] = "Sim")
			VAR parcA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] = "Sim")
			VAR aprA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] = "Aprendiz")
			VAR TotC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR cltC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] <> "Sim", F_rais[modalidade_contrato] = "CLT Prazo Indeterminado")
			VAR detC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] <> "Sim", F_rais[modalidade_contrato] IN {"CLT Prazo Determinado", "Contrato por Prazo Determinado", "Temporário", "Contrato Temporário"})
			VAR interC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] = "Sim")
			VAR parcC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] <> "Aprendiz", F_rais[trabalho_parcial] = "Sim")
			VAR aprC = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, F_rais[trabalho_intermitente] <> "Sim", F_rais[modalidade_contrato] = "Aprendiz")
			VAR PA = DIVIDE(cltA, TotA)
			VAR PC = DIVIDE(cltC, TotC)
			VAR DA = DIVIDE(detA, TotA)
			VAR DC = DIVIDE(detC, TotC)
			VAR L1 = IF(ISBLANK(A) || TotA = 0, "Sem dados para os filtros escolhidos", IF(ISBLANK(PA), "—", FORMAT(PA, "0.0%", "pt-BR")) & " dos empregos do AFL são CLT por prazo indeterminado")
			VAR L2 = IF(L1 = "Sem dados para os filtros escolhidos", "", "Prazo determinado ou temporário: " & IF(ISBLANK(DA), "—", FORMAT(DA, "0.0%", "pt-BR")) & " no AFL e " & IF(ISBLANK(DC), "—", FORMAT(DC, "0.0%", "pt-BR")) & " nos comparáveis")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#1D1E21" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Empregos\Títulos
		lineageTag: e3fd4918-768f-4edd-a790-3a9d427e06e8

	/// Empregos em 31/12 da divisão de D_Rank_Divisao no ano de referência; o item AFL usa os seis CNAEs e as divisões não incluem os CNAEs do AFL.
	measure Emp_Divisao =
			VAR Nome = SELECTEDVALUE(D_Rank_Divisao[nm_divisao])
			VAR A = [Ano_Ref]
			RETURN IF(ISBLANK(Nome) || ISBLANK(A), BLANK(), IF(Nome = "AFL · conjunto de 6 CNAEs", [Empregos_Ref_AFL],
			    CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), KEEPFILTERS(D_Cnae[nm_divisao] = Nome), KEEPFILTERS(D_Cnae[setor_afl] = "Não"))))
		formatString: #,0
		displayFolder: Empregos\Ranking
		lineageTag: 71a7633b-5c67-4434-85f4-4044d2f50886

	/// Valor do ranking: as 10 maiores divisões em empregos e sempre o AFL; as demais voltam BLANK.
	measure Emp_Divisao_Top =
			VAR EhAFL = SELECTEDVALUE(D_Rank_Divisao[nm_divisao]) = "AFL · conjunto de 6 CNAEs"
			VAR Valor = [Emp_Divisao]
			VAR Posicao = IF(NOT ISBLANK(Valor), RANKX(ALLSELECTED(D_Rank_Divisao[nm_divisao]), [Emp_Divisao], , DESC, DENSE))
			RETURN IF(NOT ISBLANK(Valor) && (EhAFL || Posicao <= 10), Valor)
		formatString: #,0
		displayFolder: Empregos\Ranking
		lineageTag: f7844ebd-3620-46ba-b927-a3a455d4beee

	/// Cor do ranking: AFL em laranja, demais divisões em cinza neutro.
	measure Cor_Emp_Divisao = IF(SELECTEDVALUE(D_Rank_Divisao[nm_divisao]) = "AFL · conjunto de 6 CNAEs", "#F58220", "#DDDDDE")
		isHidden
		displayFolder: Empregos\Ranking
		lineageTag: 90b1ebf2-702c-4daa-a081-8de7325700a0

	/// Posição do AFL entre todas as divisões em empregos (ignora os botões de setor).
	measure Emp_Posicao_AFL_Divisao =
			VAR Divs = ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Emp_Divisao])
			VAR Validas = FILTER(Divs, NOT ISBLANK([@v]))
			VAR ValorAFL = MAXX(FILTER(Validas, [nm_divisao] = "AFL · conjunto de 6 CNAEs"), [@v])
			RETURN IF(NOT ISBLANK(ValorAFL), COUNTROWS(FILTER(Validas, [@v] > ValorAFL)) + 1)
		formatString: 0
		isHidden
		displayFolder: Empregos\Ranking
		lineageTag: 367a9618-d703-4c4d-8c2d-33456d526fbf

	/// Quantidade de divisões com empregos no contexto (ignora os botões de setor).
	measure Emp_Total_Divisoes = COUNTROWS(FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Emp_Divisao]), NOT ISBLANK([@v])))
		formatString: 0
		isHidden
		displayFolder: Empregos\Ranking
		lineageTag: 51907d7d-00e8-49ed-826b-01c69af6f7a8

	/// Título do ranking de divisões: posição do AFL em empregos e em crescimento.
	measure Titulo_Emp_Ranking_HTML =
			VAR Pos = [Emp_Posicao_AFL_Divisao]
			VAR N = [Emp_Total_Divisoes]
			VAR L1 = IF(ISBLANK(Pos), "O AFL não tem empregos para os filtros escolhidos", IF(Pos = 1, "O AFL é a maior divisão do emprego formal entre as " & N, "O AFL é a " & Pos & "ª maior divisão do emprego formal entre as " & N))
			VAR L2 = IF(ISBLANK(Pos), "", "O gráfico mostra as 10 maiores divisões e o AFL, em empregos de 31/12/" & [Ano_Ref] & ". Compare por participação, nunca o AFL contra o total.")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#F58220" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
