		lineageTag: df5f01ac-4725-4e8d-a824-2f119c6f745a

	/// Manchete da aba Quem contrata (Todos os setores).
	measure Manchete_Contrata_Total_HTML =
			VAR Pos = [Ind_Posicao_AFL]
			VAR N = [Ind_Total_Divisoes]
			VAR A = [Ind_Ano]
			VAR Afl = [Ind_Valor_AFL]
			VAR Comp = [Ind_Valor_Comp]
			VAR Rot = [Ind_Rotulo]
			VAR Frase = [Ind_Frase]
			VAR Texto = IF(ISBLANK(Pos), "O AFL não tem dados de " & Rot & " para os filtros escolhidos", "Em " & Rot & ", o AFL é o " & Pos & "º entre as " & N & " divisões: " & IF(ISBLANK(Afl), "—", FORMAT(Afl, "0.0%", "pt-BR")) & " " & Frase & ", contra " & IF(ISBLANK(Comp), "—", FORMAT(Comp, "0.0%", "pt-BR")) & " nos Comparáveis")
			VAR Contexto = "31/12/" & A & IF([Ind_Atual] = "Primeiro emprego", " (último ano com a informação)", "") & " · Brasil · indicador: " & Rot & " (troque nos botões abaixo) · RAIS"
			VAR Valido = NOT ISBLANK(A)
			RETURN IF(NOT Valido, "<div role='text' style='width:100%;height:118px;font-family:Segoe UI,Arial,sans-serif;font-size:24px;color:#434446;'>Não há dados para os filtros selecionados.</div>",
			    "<div role='group' aria-label='Quem mais contrata' style='width:100%;height:118px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='max-height:84px;overflow:hidden;'><span style='display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;min-width:0;font-size:34px;line-height:40px;font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Texto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span></div>"
			        & "<div style='height:30px;margin:4px 0 0;font-size:24px;line-height:30px;color:#434446;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Contexto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div></div>")
		displayFolder: HTML\Quem contrata
		lineageTag: 0d19ea9d-a0d1-43f0-9453-9e21a4b89f41

	/// KPI 1: posição do AFL no ranking de divisões.
	measure KPI_Contrata1_Total_HTML =
			VAR Pos = [Ind_Posicao_AFL]
			VAR N = [Ind_Total_Divisoes]
			VAR Afl = [Ind_Valor_AFL]
			VAR Comp = [Ind_Valor_Comp]
			RETURN
			    "<div role='group' aria-label='KPI de posição do AFL' style='width:100%;height:172px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='font-size:24px;line-height:28px;font-weight:600;color:#434446;white-space:nowrap;'>" & "Posição do AFL no ranking" & "</div>"
			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK(Pos), "—", Pos & "º") & "</div>"
			        & "<div style='margin-top:3px;font-size:20px;line-height:24px;max-height:48px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;color:" & "#434446" & ";overflow:hidden;'>" & IF(ISBLANK(Pos), "sem dados no indicador", "entre " & N & " divisões, pela participação de " & [Ind_Rotulo]) & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #F58220;border-radius:6px;background:#FDF7F1;color:#B86218;font-size:20px;line-height:26px;font-weight:600;'>AFL " & IF(ISBLANK(Afl), "—", FORMAT(Afl, "0.0%", "pt-BR")) & "</span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Quem contrata\KPIs
		lineageTag: ce00bee5-97e9-45df-8550-e3d571782f6d

	/// KPI 2: diferença do AFL para os Comparáveis em pontos percentuais.
	measure KPI_Contrata2_Total_HTML =
			VAR Afl = [Ind_Valor_AFL]
			VAR Comp = [Ind_Valor_Comp]
			VAR Dif = (Afl - Comp) * 100
			RETURN
			    "<div role='group' aria-label='KPI de diferença para os Comparáveis' style='width:100%;height:172px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='font-size:24px;line-height:28px;font-weight:600;color:#434446;white-space:nowrap;'>" & "AFL menos Comparáveis" & "</div>"
			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK(Dif), "—", IF(Dif > 0, "+", IF(Dif < 0, "−", "")) & FORMAT(ABS(Dif), "0.0", "pt-BR") & "<span style='font-size:28px;font-weight:400;'> p.p.</span>") & "</div>"
			        & "<div style='margin-top:3px;font-size:20px;line-height:24px;max-height:48px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;color:" & "#434446" & ";overflow:hidden;'>" & IF(ISBLANK(Dif), "", "pontos percentuais: o AFL tem " & IF(Dif > 0, "mais ", "menos ") & [Ind_Quem]) & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #434446;border-radius:6px;background:#F2F4F7;color:#1D1E21;font-size:20px;line-height:26px;font-weight:600;'>Comparáveis " & IF(ISBLANK(Comp), "—", FORMAT(Comp, "0.0%", "pt-BR")) & " <span style='font-weight:400;font-size:17px;color:#434446;'>· ref.</span></span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Quem contrata\KPIs
		lineageTag: 19e4c07a-18c7-4a03-a91a-7af28215d83f

