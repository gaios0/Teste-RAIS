			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK([Ind_Maior_Valor]), "—", FORMAT([Ind_Maior_Valor], "0.0%", "pt-BR")) & "</div>"
			        & "<div style='margin-top:3px;font-size:20px;line-height:24px;max-height:48px;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;color:" & "#434446" & ";overflow:hidden;'>" & [Ind_Maior_Divisao] & "</div>"
