	/// KPI de empregos (página AFL): estoque em 31/12 com variação e referência dos comparáveis.
	measure KPI_Emp_AFL_HTML =
			VAR A = [Ano_Ref]
			VAR Valor = [Empregos_Ref]
			VAR Variacao = [Empregos_Var]
			VAR VarPct = [Empregos_Var_Pct]
			VAR Icone = SWITCH(TRUE(), Variacao > 0, "▲", Variacao < 0, "▼", "●")
			VAR Cor = SWITCH(TRUE(), Variacao > 0, "#137547", Variacao < 0, "#B42318", "#434446")
			VAR Linha = IF(NOT ISBLANK(Variacao), Icone & " " & IF(Variacao > 0, "+", IF(Variacao < 0, "−", "")) & FORMAT(ABS(Variacao), "#,0", "pt-BR") & " (" & IF(ISBLANK(VarPct), "—", IF(VarPct > 0, "+", IF(VarPct < 0, "−", "")) & FORMAT(ABS(VarPct), "0.0%", "pt-BR")) & ") sobre " & (A - 1),
			    IF(A = 2022, "2022 não se compara com 2021 (nova fonte: eSocial)", "Primeiro ano da série"))
			VAR CorLinha = IF(ISBLANK(Variacao), "#434446", Cor)
			VAR VarComp = [Empregos_Var_Pct_Comparavel]
			RETURN
			    "<div role='group' aria-label='KPI de empregos formais' style='width:100%;height:156px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='font-size:24px;line-height:28px;font-weight:600;color:#434446;white-space:nowrap;'>" & "Empregos em 31/12/" & A & "</div>"
			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & FORMAT(Valor, "#,0", "pt-BR") & "</div>"
			        & "<div style='margin-top:3px;font-size:22px;line-height:26px;color:" & CorLinha & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & Linha & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #434446;border-radius:6px;background:#F2F4F7;color:#1D1E21;font-size:20px;line-height:26px;font-weight:600;'>Comparáveis " & IF(ISBLANK(VarComp), "—", IF(VarComp > 0, "+", IF(VarComp < 0, "−", "")) & FORMAT(ABS(VarComp), "0.0%", "pt-BR")) & " <span style='font-weight:400;font-size:17px;color:#434446;'>· ref.</span></span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Empregos\KPIs
		lineageTag: de3ebcb8-657a-4947-adda-0e5422bb8d88

	/// KPI de empregos (página Todos os setores): estoque em 31/12 com variação, chip AFL e referência dos comparáveis.
	measure KPI_Emp_Total_HTML =
			VAR A = [Ano_Ref]
			VAR Valor = [Empregos_Ref]
			VAR Variacao = [Empregos_Var]
			VAR VarPct = [Empregos_Var_Pct]
			VAR Icone = SWITCH(TRUE(), Variacao > 0, "▲", Variacao < 0, "▼", "●")
			VAR Cor = SWITCH(TRUE(), Variacao > 0, "#137547", Variacao < 0, "#B42318", "#434446")
			VAR Linha = IF(NOT ISBLANK(Variacao), Icone & " " & IF(Variacao > 0, "+", IF(Variacao < 0, "−", "")) & FORMAT(ABS(Variacao), "#,0", "pt-BR") & " (" & IF(ISBLANK(VarPct), "—", IF(VarPct > 0, "+", IF(VarPct < 0, "−", "")) & FORMAT(ABS(VarPct), "0.0%", "pt-BR")) & ") sobre " & (A - 1),
			    IF(A = 2022, "2022 não se compara com 2021 (nova fonte: eSocial)", "Primeiro ano da série"))
			VAR CorLinha = IF(ISBLANK(Variacao), "#434446", Cor)
			VAR VarAFL = [Empregos_Var_Pct_AFL]
			VAR VarComp = [Empregos_Var_Pct_Comparavel]
			RETURN
			    "<div role='group' aria-label='KPI de empregos formais' style='width:100%;height:156px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='font-size:24px;line-height:28px;font-weight:600;color:#434446;white-space:nowrap;'>" & "Empregos em 31/12/" & A & "</div>"
			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & FORMAT(Valor, "#,0", "pt-BR") & "</div>"
			        & "<div style='margin-top:3px;font-size:22px;line-height:26px;color:" & CorLinha & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & Linha & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #F58220;border-radius:6px;background:#FDF7F1;color:#B86218;font-size:20px;line-height:26px;font-weight:600;'>AFL " & IF(ISBLANK(VarAFL), "—", IF(VarAFL > 0, "+", IF(VarAFL < 0, "−", "")) & FORMAT(ABS(VarAFL), "0.0%", "pt-BR")) & "</span>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #434446;border-radius:6px;background:#F2F4F7;color:#1D1E21;font-size:20px;line-height:26px;font-weight:600;'>Comparáveis " & IF(ISBLANK(VarComp), "—", IF(VarComp > 0, "+", IF(VarComp < 0, "−", "")) & FORMAT(ABS(VarComp), "0.0%", "pt-BR")) & " <span style='font-weight:400;font-size:17px;color:#434446;'>· ref.</span></span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Empregos\KPIs
		lineageTag: 1cb65d12-1839-419e-9815-f9aa7bfb417f

	/// KPI de peso (página AFL): AFL ÷ (AFL + comparáveis) e participação em todo o emprego formal.
	measure KPI_Peso_AFL_HTML =
			VAR Afl = [Empregos_Ref_AFL]
			VAR Comp = [Empregos_Ref_Comparavel]
			VAR Todos = [Empregos_Ref_Todos]
			VAR Peso = DIVIDE(Afl, Afl + Comp)
			VAR PesoTodos = DIVIDE(Afl, Todos)
			RETURN
			    "<div role='group' aria-label='KPI de peso do AFL' style='width:100%;height:156px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='font-size:24px;line-height:28px;font-weight:600;color:#434446;white-space:nowrap;'>" & "Peso nos empregos comparáveis" & "</div>"
			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK(Peso), "—", FORMAT(Peso, "0.0%", "pt-BR")) & "</div>"
			        & "<div style='margin-top:3px;font-size:22px;line-height:26px;color:" & "#434446" & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & "dos empregos do AFL + comparáveis" & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='font-size:21px;color:#434446;'>" & IF(ISBLANK(PesoTodos), "—", FORMAT(PesoTodos, "0.0%", "pt-BR")) & " de todo o emprego formal</span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Empregos\KPIs
		lineageTag: e46739b3-39ed-46cd-bfb4-22df72c9855d

	/// KPI de peso (página Todos os setores): AFL ÷ todo o emprego formal e AFL ÷ (AFL + comparáveis).
	measure KPI_Peso_Total_HTML =
			VAR Afl = [Empregos_Ref_AFL]
			VAR Comp = [Empregos_Ref_Comparavel]
			VAR Todos = [Empregos_Ref_Todos]
			VAR Peso = DIVIDE(Afl, Todos)
			VAR PesoComp = DIVIDE(Afl, Afl + Comp)
			RETURN
			    "<div role='group' aria-label='KPI de peso do AFL' style='width:100%;height:156px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
