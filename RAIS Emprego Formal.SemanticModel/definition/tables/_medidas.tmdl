	/// Remuneração média de dezembro por UF (10 maiores).
	measure Rem_UF_Top =
			VAR V = [Remuneracao_Media_Ref]
			VAR R = IF(NOT ISBLANK(V), RANKX(ALLSELECTED(D_UF[uf]), [Remuneracao_Media_Ref], , DESC, DENSE))
			RETURN IF(NOT ISBLANK(V) && R <= 10, V)
