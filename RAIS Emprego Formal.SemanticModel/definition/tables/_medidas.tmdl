			VAR Posicao = IF(NOT ISBLANK([Empregos_Ref_AFL]), RANKX(ALLSELECTED(D_UF[uf]), [Empregos_Ref_AFL], , DESC, DENSE))
			RETURN IF(NOT ISBLANK(Valor) && Posicao <= 10, Valor)
