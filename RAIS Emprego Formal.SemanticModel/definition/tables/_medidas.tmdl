	/// Título das UFs: onde o AFL tem a maior participação do indicador.
	measure Titulo_Contrata_UF_HTML =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_UF[uf]), "@v", [Ind_UF_Top]), NOT ISBLANK([@v]))
			VAR Lider1 = TOPN(1, T, [@v], DESC, D_UF[uf], ASC)
			VAR UF = CONCATENATEX(Lider1, D_UF[uf], "")
			VAR V = MAXX(Lider1, [@v])
			VAR L1 = IF(COUNTROWS(T) = 0, "Sem dados para os filtros escolhidos", "Em " & UF & " o AFL tem a maior participação de " & [Ind_Rotulo] & ": " & IF(ISBLANK(V), "—", FORMAT(V, "0.0%", "pt-BR")))
			VAR L2 = IF(COUNTROWS(T) = 0, "", "Só dos empregos do AFL, por UF (10 maiores; UFs com 3 mil empregos do AFL ou mais)")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#1D1E21" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quem contrata\Títulos
		lineageTag: 9a57b285-6b34-499f-904c-774df1a94525

	/// Título das UFs no mercado filtrado: onde o indicador é maior.
	measure Titulo_Contrata_UF_Total_HTML =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_UF[uf]), "@v", [Ind_UF_Todos_Top]), NOT ISBLANK([@v]))
			VAR Lider1 = TOPN(1, T, [@v], DESC, D_UF[uf], ASC)
			VAR UF = CONCATENATEX(Lider1, D_UF[uf], "")
			VAR V = MAXX(Lider1, [@v])
			VAR VA = CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", KEEPFILTERS(TREATAS({UF}, D_UF[uf])))
			VAR L1 = IF(COUNTROWS(T) = 0, "Sem dados para os filtros escolhidos", "Em " & UF & " é maior a participação de " & [Ind_Rotulo] & ": " & IF(ISBLANK(V), "—", FORMAT(V, "0.0%", "pt-BR")))
			VAR L2 = IF(COUNTROWS(T) = 0, "", "Todos os empregados do recorte, por UF (10 maiores; UFs com 3 mil empregos ou mais)" & IF(ISBLANK(VA), "", " · AFL em " & UF & ": " & IF(ISBLANK(VA), "—", FORMAT(VA, "0.0%", "pt-BR"))))
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#1D1E21" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quem contrata\Títulos
		lineageTag: 93477112-f7db-4b8f-8be7-1d861454be90

