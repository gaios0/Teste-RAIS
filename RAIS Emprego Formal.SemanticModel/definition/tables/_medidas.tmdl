	/// Indicador escolhido por UF no mercado filtrado (10 maiores; só UFs com 3 mil empregos ou mais no recorte).
	measure Ind_UF_Todos_Top =
			VAR IA = [Ind_Ano]
			VAR Den = CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = IA)
			VAR V = IF(Den >= 3000, [Ind_Valor_Ctx])
			VAR R = IF(NOT ISBLANK(V), RANKX(ALLSELECTED(D_UF[uf]), [Ind_Valor_Ctx], , DESC, DENSE))
			RETURN IF(NOT ISBLANK(V) && R <= 10, V)
		formatString: 0.0%
		displayFolder: Quem contrata\UF
