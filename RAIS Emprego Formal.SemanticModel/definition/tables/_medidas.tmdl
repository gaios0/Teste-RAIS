		lineageTag: 87dd818d-535f-47d7-a1d6-f0df7727b24d

	/// Remuneracao_Mediana_Ref só do grupo Comparável, independente do filtro de setores da página.
	measure Remuneracao_Mediana_Ref_Comparavel = CALCULATE([Remuneracao_Mediana_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
		formatString: #,0.00
		displayFolder: Base\Comparavel
		lineageTag: b93d77c2-c634-4024-8b11-61b53c6d2c02

	/// Empregos do AFL em 31/12 do ano da variável A (para uso em tabelas de anos).
	measure Emp_Grupo_AFL_Ano =
			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A), CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A))
		formatString: #,0
		isHidden
		displayFolder: Empregos\Apoio
		lineageTag: 84b90ca2-158b-47d5-9f0e-7cefb56cb322

	/// Empregos do ano de referência ignorando setor, comparabilidade e atividade (mantém UF, sexo, escolaridade e raça).
	measure Empregos_Ref_Todos =
			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A), CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), REMOVEFILTERS(D_Comparavel), REMOVEFILTERS(D_AflAtividade), REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A))
		formatString: #,0
		displayFolder: Empregos\Apoio
		lineageTag: 98ffb536-bf59-49df-b5b2-dc3f5237fbce

	/// Quantos anos seguidos o emprego do AFL subiu, terminando no ano de referência e sem atravessar a quebra de 2022.
	measure Emp_Sequencia_Altas_AFL =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR T = ADDCOLUMNS(GENERATESERIES(I + 1, MAX(A, I + 1)), "@var", VAR y = [Value] RETURN
			    CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = y) - CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = y - 1))
			VAR UltimaNaoAlta = MAXX(FILTER(T, [@var] <= 0), [Value])
			RETURN IF(A > I, A - COALESCE(UltimaNaoAlta, I), 0)
		formatString: 0
		isHidden
		displayFolder: Empregos\Apoio
		lineageTag: 02153a88-cf59-4917-b7f5-a07e2113962d

	/// Índice de empregos do AFL (base 100 = primeiro ano do trecho), trecho 2009–2021; BLANK fora do trecho.
	measure Emp_Indice_AFL_Pre =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Fim = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR Base = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			RETURN IF(NOT ISBLANK(A) && A < 2022 && Base > 0, DIVIDE(Fim, Base) * 100)
		formatString: 0.0
		displayFolder: Empregos\Séries
		lineageTag: 970060e7-0da8-4e0a-93f4-614d16caa9f5

	/// Índice de empregos do AFL (base 100 = primeiro ano do trecho), trecho 2022 em diante; BLANK fora do trecho.
	measure Emp_Indice_AFL_Pos =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Fim = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR Base = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			RETURN IF(NOT ISBLANK(A) && A >= 2022 && Base > 0, DIVIDE(Fim, Base) * 100)
		formatString: 0.0
		displayFolder: Empregos\Séries
		lineageTag: cc960667-8031-40b5-b047-f5c2899114dd

