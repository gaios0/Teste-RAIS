	measure Empregos_Var_Pct_AFL = CALCULATE([Empregos_Var_Pct], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL")
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Base\AFL
		lineageTag: 6d246386-06a4-49af-8ab0-aeaebcf0f16e

	/// Empregos_Var_Pct só do grupo Comparável, independente do filtro de setores da página.
	measure Empregos_Var_Pct_Comparavel = CALCULATE([Empregos_Var_Pct], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
		formatString: +0.0%;-0.0%;0.0%
