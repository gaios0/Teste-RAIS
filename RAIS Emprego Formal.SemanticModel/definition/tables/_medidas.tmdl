en;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Comparáveis", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(RC), "—", FORMAT(RC, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK("Negros " & IF(ISBLANK(CA), "—", "R$ " & FORMAT(CA, "#,0", "pt-BR")) & " · brancos " & IF(ISBLANK(CB), "—", "R$ " & FORMAT(CB, "#,0", "pt-BR"))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Negros " & IF(ISBLANK(CA), "—", "R$ " & FORMAT(CA, "#,0", "pt-BR")) & " · brancos " & IF(ISBLANK(CB), "—", "R$ " & FORMAT(CB, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(NOT PaginaAFL, "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#98A2B3;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Seleção atual", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(RS), "—", FORMAT(RS, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(Leitura = "", "", "<div style='margin-top:14px;padding:9px 12px;border-left:4px solid #F58220;borde