	/// Título das UFs (página AFL): UF líder e participação nos empregos do AFL, com a UF onde o AFL mais pesa.
	measure Titulo_Emp_UF_AFL_HTML =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_UF[uf]), "@v", [Empregos_Ref], "@p", [Emp_UF_Peso_AFL]), NOT ISBLANK([@v]))
			VAR Tot = SUMX(T, [@v])
			VAR Lider = TOPN(1, T, [@v], DESC, D_UF[uf], ASC)
			VAR UF = CONCATENATEX(Lider, D_UF[uf], "")
			VAR Mais = TOPN(1, T, [@p], DESC, D_UF[uf], ASC)
			VAR UFMais = CONCATENATEX(Mais, D_UF[uf], "")
			VAR PMais = MAXX(Mais, [@p])
			VAR L1 = IF(Tot = 0, "Sem dados para os filtros escolhidos", IF(COUNTROWS(T) = 1, UF & " reúne os empregos do filtro", UF & " tem " & IF(ISBLANK(DIVIDE(MAXX(Lider, [@v]), Tot)), "—", FORMAT(DIVIDE(MAXX(Lider, [@v]), Tot), "0.0%", "pt-BR")) & " dos empregos do AFL"))
			VAR L2 = IF(Tot = 0 || COUNTROWS(T) = 1, "", "Onde o AFL pesa mais: " & UFMais & " (" & IF(ISBLANK(PMais), "—", FORMAT(PMais, "0.0%", "pt-BR")) & " dos empregos comparáveis)")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
