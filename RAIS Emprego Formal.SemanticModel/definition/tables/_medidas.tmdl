	/// Tooltip da razão mulheres ÷ homens por escolaridade: razão e salários médios de cada grupo no AFL e nos Comparáveis.
	measure Tip_Rem_Gap_Sexo_HTML =
			VAR E = SELECTEDVALUE(D_Escolaridade[escolaridade_agrupada])
			VAR RA = [Rem_Razao_Sexo_AFL]
			VAR RC = [Rem_Razao_Sexo_Comp]
			VAR RS = [Rem_Razao_Sexo]
			VAR AA = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Sexo), D_Sexo[sexo] = "Mulher")
			VAR AB = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Sexo), D_Sexo[sexo] = "Homem")
			VAR CA = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Sexo), D_Sexo[sexo] = "Mulher")
			VAR CB = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Sexo), D_Sexo[sexo] = "Homem")
			VAR PaginaAFL = SELECTEDVALUE(D_Cnae[setor_afl]) = "Sim"
			VAR Leitura = IF(ISBLANK(RA) || ISBLANK(RC), "", "A diferença no AFL é " & IF(RA >= RC, "menor", "maior") & " que nos Comparáveis (" & IF(ISBLANK(RA) || ISBLANK(RC), "", IF(RA >= RC, "+", "−") & FORMAT(ABS(RA - RC) * 100, "0.0", "pt-BR") & " p.p.") & "). 100% = salários iguais.")
			RETURN
			    "<div role='group' style='font-family:Segoe UI,Arial,sans-serif;padding:18px 22px;box-sizing:border-box;color:#1D1E21;background:#FFFFFF;'>" & "<div style='font-size:24px;line-height:30px;font-weight:600;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(E, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & "<div style='font-size:18px;line-height:24px;color:#667085;margin-top:2px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Salário dos mulheres como % do dos homens", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#F58220;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("AFL", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(RA), "—", FORMAT(RA, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK("Mulheres " & IF(ISBLANK(AA), "—", "R$ " & FORMAT(AA, "#,0", "pt-BR")) & " · homens " & IF(ISBLANK(AB), "—", "R$ " & FORMAT(AB, "#,0", "pt-BR"))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Mulheres " & IF(ISBLANK(AA), "—", "R$ " & FORMAT(AA, "#,0", "pt-BR")) & " · homens " & IF(ISBLANK(AB), "—", "R$ " & FORMAT(AB, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Comparáveis", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(RC), "—", FORMAT(RC, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK("Mulheres " & IF(ISBLANK(CA), "—", "R$ " & FORMAT(CA, "#,0", "pt-BR")) & " · homens " & IF(ISBLANK(CB), "—", "R$ " & FORMAT(CB, "#,0", "pt-BR"))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Mulheres " & IF(ISBLANK(CA), "—", "R$ " & FORMAT(CA, "#,0", "pt-BR")) & " · homens " & IF(ISBLANK(CB), "—", "R$ " & FORMAT(CB, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(NOT PaginaAFL, "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#98A2B3;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Seleção atual", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(RS), "—", FORMAT(RS, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(Leitura = "", "", "<div style='margin-top:14px;padding:9px 12px;border-left:4px solid #F58220;border-radius:0 6px 6px 0;background:#FDF7F1;font-size:18px;line-height:25px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Leitura, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>"
		displayFolder: HTML\Tooltips de gráficos
		lineageTag: fd03f196-411c-4d57-a21b-7b3e0b1088f2

	/// Tooltip da razão negros ÷ brancos por escolaridade: razão e salários médios de cada grupo no AFL e nos Comparáveis.
	measure Tip_Rem_Gap_Raca_HTML =
			VAR E = SELECTEDVALUE(D_Escolaridade[escolaridade_agrupada])
			VAR RA = [Rem_Razao_Raca_AFL]
			VAR RC = [Rem_Razao_Raca_Comp]
			VAR RS = [Rem_Razao_Raca]
			VAR AA = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), D_Raca[grupo_raca] = "Negra")
			VAR AB = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), D_Raca[grupo_raca] = "Branca")
			VAR CA = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), D_Raca[grupo_raca] = "Negra")
			VAR CB = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), D_Raca[grupo_raca] = "Branca")
			VAR PaginaAFL = SELECTEDVALUE(D_Cnae[setor_afl]) = "Sim"
			VAR Leitura = IF(ISBLANK(RA) || ISBLANK(RC), "", "A diferença no AFL é " & IF(RA >= RC, "menor", "maior") & " que nos Comparáveis (" & IF(ISBLANK(RA) || ISBLANK(RC), "", IF(RA >= RC, "+", "−") & FORMAT(ABS(RA - RC) * 100, "0.0", "pt-BR") & " p.p.") & "). 100% = salários iguais.")
			RETURN
