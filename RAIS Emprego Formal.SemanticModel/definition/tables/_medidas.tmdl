		lineageTag: 9e3995ab-d975-4da9-99de-63909e65d92c

	/// Empregos_Cresc_Medio_Ano só do grupo AFL, independente do filtro de setores da página.
	measure Empregos_Cresc_Medio_Ano_AFL = CALCULATE([Empregos_Cresc_Medio_Ano], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL")
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Base\AFL
		lineageTag: ffccf56f-00ab-455f-a84b-9f6cee97f17d

	/// Empregos_Cresc_Medio_Ano só do grupo Comparável, independente do filtro de setores da página.
	measure Empregos_Cresc_Medio_Ano_Comparavel = CALCULATE([Empregos_Cresc_Medio_Ano], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
		formatString: +0.0%;-0.0%;0.0%
		displayFolder: Base\Comparavel
		lineageTag: 93260bbd-dfb3-4c62-946b-b8452a88647b

	/// Remuneracao_Media_Ref só do grupo AFL, independente do filtro de setores da página.
	measure Remuneracao_Media_Ref_AFL = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL")
		formatString: #,0.00
		displayFolder: Base\AFL
		lineageTag: ea1378c2-46ee-4a35-bfd9-f66c6268baf1

	/// Remuneracao_Media_Ref só do grupo Comparável, independente do filtro de setores da página.
	measure Remuneracao_Media_Ref_Comparavel = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
		formatString: #,0.00
