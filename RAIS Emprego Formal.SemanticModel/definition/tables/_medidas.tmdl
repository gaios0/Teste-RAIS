	/// Tooltip do ano na variação anual do emprego: empregos e variação do AFL, Comparáveis e seleção atual.
	measure Tip_Emp_Ano_HTML =
			VAR A = SELECTEDVALUE(D_Calendario[Ano])
			VAR EA = [Empregos_Ref_AFL]
			VAR VA = [Empregos_Var_Pct_AFL]
			VAR EC = [Empregos_Ref_Comparavel]
			VAR VC = [Empregos_Var_Pct_Comparavel]
			VAR ES = [Empregos_Ref]
			VAR VS = [Empregos_Var_Pct]
			VAR PaginaAFL = SELECTEDVALUE(D_Cnae[setor_afl]) = "Sim"
			VAR Leitura = IF(ISBLANK(VA) || ISBLANK(VC), "", "Em " & A & ", o emprego do AFL " & IF(VA >= VC, "cresceu mais", "cresceu menos") & " que o dos Comparáveis (" & IF(ISBLANK(VA) || ISBLANK(VC), "", IF(VA >= VC, "+", "−") & FORMAT(ABS(VA - VC) * 100, "0.0", "pt-BR") & " p.p.") & ").")
			RETURN
			    "<div role='group' style='font-family:Segoe UI,Arial,sans-serif;padding:18px 22px;box-sizing:border-box;color:#1D1E21;background:#FFFFFF;'>" & "<div style='font-size:24px;line-height:30px;font-weight:600;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("31/12/" & A, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & "<div style='font-size:18px;line-height:24px;color:#667085;margin-top:2px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(VA), IF(A = 2022, "Sem comparação com 2021: nova fonte (eSocial)", "Primeiro ano da série"), "Variação sobre 31/12/" & (A - 1)), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#F58220;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("AFL", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(EA, "#,0", "pt-BR"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK(IF(ISBLANK(VA), BLANK(), IF(ISBLANK(VA), "—", IF(VA > 0, "+", IF(VA < 0, "−", "")) & FORMAT(ABS(VA), "0.0%", "pt-BR")))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(VA), BLANK(), IF(ISBLANK(VA), "—", IF(VA > 0, "+", IF(VA < 0, "−", "")) & FORMAT(ABS(VA), "0.0%", "pt-BR"))), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Comparáveis", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(EC, "#,0", "pt-BR"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK(IF(ISBLANK(VC), BLANK(), IF(ISBLANK(VC), "—", IF(VC > 0, "+", IF(VC < 0, "−", "")) & FORMAT(ABS(VC), "0.0%", "pt-BR")))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(VC), BLANK(), IF(ISBLANK(VC), "—", IF(VC > 0, "+", IF(VC < 0, "−", "")) & FORMAT(ABS(VC), "0.0%", "pt-BR"))), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(NOT PaginaAFL, "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#98A2B3;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Seleção atual", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(ES, "#,0", "pt-BR"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK(IF(ISBLANK(VS), BLANK(), IF(ISBLANK(VS), "—", IF(VS > 0, "+", IF(VS < 0, "−", "")) & FORMAT(ABS(VS), "0.0%", "pt-BR")))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(VS), BLANK(), IF(ISBLANK(VS), "—", IF(VS > 0, "+", IF(VS < 0, "−", "")) & FORMAT(ABS(VS), "0.0%", "pt-BR"))), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(Leitura = "", "", "<div style='margin-top:14px;padding:9px 12px;border-left:4px solid #F58220;border-radius:0 6px 6px 0;background:#FDF7F1;font-size:18px;line-height:25px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Leitura, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>"
		displayFolder: HTML\Tooltips de gráficos
		lineageTag: 9a4136b2-6ccc-4bc0-a576-5bd7ad8ca90c

	/// Tooltip da divisão no ranking de empregos: empregos, peso no emprego formal e posição.
	measure Tip_Emp_Divisao_HTML =
			VAR N = SELECTEDVALUE(D_Rank_Divisao[nm_divisao])
			VAR E = [Emp_Divisao]
			VAR Tot = [Empregos_Ref_Todos]
			VAR Pos = IF(NOT ISBLANK(E), RANKX(ALL(D_Rank_Divisao[nm_divisao]), [Emp_Divisao], , DESC, DENSE))
			VAR NDiv = [Emp_Total_Divisoes]
			VAR Peso = DIVIDE(E, Tot)
			VAR Leitura = IF(ISBLANK(Pos), "", IF(N = "AFL · conjunto de 6 CNAEs", "O AFL reúne seis atividades de alimentação fora do lar; as demais barras são divisões da CNAE.", "Divisão da CNAE (dois dígitos)."))
			RETURN
			    "<div role='group' style='font-family:Segoe UI,Arial,sans-serif;padding:18px 22px;box-sizing:border-box;color:#1D1E21;background:#FFFFFF;'>" & "<div style='font-size:24px;line-height:30px;font-weight:600;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(N, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & "<div style='font-size:18px;line-height:24px;color:#667085;margin-top:2px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Empregos em 31/12/" & [Ano_Ref], "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Empregos", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(E, "#,0", "pt-BR"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Peso no emprego formal", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(Peso), "—", FORMAT(Peso, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Posição no ranking", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(Pos), "—", Pos & "º de " & NDiv), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(Leitura = "", "", "<div style='margin-top:14px;padding:9px 12px;border-left:4px solid #F58220;border-radius:0 6px 6px 0;background:#FDF7F1;font-size:18px;line-height:25px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Leitura, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>"
		displayFolder: HTML\Tooltips de gráficos
		lineageTag: f32798b2-f273-4cb1-b8b8-94b91513b198

	/// Tooltip da atividade do AFL: empregos, peso no AFL, variação e posição.
	measure Tip_Emp_Atividade_HTML =
			VAR N = SELECTEDVALUE(D_AflAtividade[nome])
			VAR E = [Empregos_Ref]
			VAR Tot = [Empregos_Ref_AFL]
			VAR Peso = DIVIDE(E, Tot)
			VAR Var = [Emp_Atividade_Var]
			VAR Pos = IF(NOT ISBLANK(E), RANKX(ALL(D_AflAtividade[nome]), [Empregos_Ref], , DESC, DENSE))
			VAR Leitura = ""
			RETURN
