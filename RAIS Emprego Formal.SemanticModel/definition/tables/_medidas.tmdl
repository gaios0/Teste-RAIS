	/// Indicador escolhido por UF, só do AFL (10 maiores UFs; só UFs com 3 mil empregos do AFL ou mais).
	measure Ind_UF_Top =
			VAR IA = [Ind_Ano]
			VAR Den = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = IA)
			VAR V = IF(Den >= 3000, CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"))
			VAR R = IF(NOT ISBLANK(V), RANKX(ALLSELECTED(D_UF[uf]), CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"), , DESC, DENSE))
			RETURN IF(NOT ISBLANK(V) && R <= 10, V)
