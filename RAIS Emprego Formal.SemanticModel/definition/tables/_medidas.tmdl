	/// Indicador escolhido por divisão (item AFL = seis CNAEs); só divisões com 50.000 empregos ou mais.
	measure Ind_Valor_Div =
			VAR Nome = SELECTEDVALUE(D_Rank_Divisao[nm_divisao])
			VAR A = [Ind_Ano]
			VAR Den = IF(Nome = "AFL · conjunto de 6 CNAEs", CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A),
			    CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), KEEPFILTERS(D_Cnae[nm_divisao] = Nome), KEEPFILTERS(D_Cnae[setor_afl] = "Não"), REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A))
			VAR Val = IF(Nome = "AFL · conjunto de 6 CNAEs", CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"),
			    CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), KEEPFILTERS(D_Cnae[nm_divisao] = Nome), KEEPFILTERS(D_Cnae[setor_afl] = "Não")))
			RETURN IF(ISBLANK(Nome) || ISBLANK(A) || Den < 50000, BLANK(), Val)
		formatString: 0.0%
		displayFolder: Quem contrata\Ranking
		lineageTag: e40e1ddd-291a-4a5d-856d-5bae5b496ed8

	/// Valor do ranking: as 10 maiores divisões no indicador e sempre o AFL; as demais voltam BLANK.
	measure Ind_Divisao_Top =
			VAR EhAFL = SELECTEDVALUE(D_Rank_Divisao[nm_divisao]) = "AFL · conjunto de 6 CNAEs"
			VAR V = [Ind_Valor_Div]
			VAR R = IF(NOT ISBLANK(V), RANKX(ALLSELECTED(D_Rank_Divisao[nm_divisao]), [Ind_Valor_Div], , DESC, DENSE))
			RETURN IF(NOT ISBLANK(V) && (EhAFL || R <= 10), V)
		formatString: 0.0%
		displayFolder: Quem contrata\Ranking
		lineageTag: b76c051d-139f-4e54-a3da-f227c740b19f

	/// Cor do ranking: AFL em laranja, demais em cinza.
	measure Cor_Ind_Divisao = IF(SELECTEDVALUE(D_Rank_Divisao[nm_divisao]) = "AFL · conjunto de 6 CNAEs", "#F58220", "#DDDDDE")
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: d52b222d-ca54-46f3-8d2a-48ddceecea46

	/// Posição do AFL entre todas as divisões no indicador escolhido.
	measure Ind_Posicao_AFL =
			VAR T = FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Ind_Valor_Div]), NOT ISBLANK([@v]))
			VAR VA = MAXX(FILTER(T, [nm_divisao] = "AFL · conjunto de 6 CNAEs"), [@v])
			RETURN IF(NOT ISBLANK(VA), COUNTROWS(FILTER(T, [@v] > VA)) + 1)
		formatString: 0
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: 389abd21-4bcb-4bc4-8d8b-95b689b3ac57

	/// Quantidade de divisões com o indicador calculável.
	measure Ind_Total_Divisoes = COUNTROWS(FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Ind_Valor_Div]), NOT ISBLANK([@v])))
		formatString: 0
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: 05884b36-ee8c-45a0-adca-31b05510fcd3

	/// Nome da divisão com o maior valor do indicador.
	measure Ind_Maior_Divisao =
			VAR T = FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Ind_Valor_Div]), NOT ISBLANK([@v]) && [nm_divisao] <> "AFL · conjunto de 6 CNAEs")
			RETURN CONCATENATEX(TOPN(1, T, [@v], DESC, [nm_divisao], ASC), [nm_divisao], "")
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: 1bedd66a-6207-4dd8-a4f7-7783b6b9bb95

	/// Maior valor do indicador entre as divisões.
	measure Ind_Maior_Valor =
			VAR T = FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Ind_Valor_Div]), NOT ISBLANK([@v]) && [nm_divisao] <> "AFL · conjunto de 6 CNAEs")
			RETURN MAXX(T, [@v])
		formatString: 0.0%
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: 67131a5e-57c6-4d63-9ed8-b90c62918dd2

	/// Atividade do AFL com o maior valor do indicador.
	measure Ind_Atividade_Lider =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_AflAtividade[nome]), "@v", [Ind_Valor_Ctx]), NOT ISBLANK([@v]))
			RETURN CONCATENATEX(TOPN(1, T, [@v], DESC, D_AflAtividade[nome], ASC), D_AflAtividade[nome], "")
		isHidden
		displayFolder: Quem contrata\Atividades
		lineageTag: f2dba365-6068-4e88-bfe1-0e618ebf4bfc

	/// Maior valor do indicador entre as atividades do AFL.
	measure Ind_Atividade_Lider_Valor =
