	/// Tooltip da pirâmide: empregos da faixa, peso da faixa e participação de mulheres (recorte, AFL e Comparáveis).
	measure Tip_Pir_HTML =
			VAR F = SELECTEDVALUE(D_FaixaIdade[faixa_idade])
			VAR E = [Empregos_Ref]
			VAR Mul = DIVIDE(CALCULATE([Empregos_Ref], KEEPFILTERS(D_Sexo[sexo] = "Mulher")), E)
			VAR MulC = CALCULATE(DIVIDE(CALCULATE([Empregos_Ref], KEEPFILTERS(D_Sexo[sexo] = "Mulher")), [Empregos_Ref]), REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
			VAR MulA = CALCULATE(DIVIDE(CALCULATE([Empregos_Ref], KEEPFILTERS(D_Sexo[sexo] = "Mulher")), [Empregos_Ref]), REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL")
			VAR TotFaixa = DIVIDE(E, CALCULATE([Empregos_Ref], REMOVEFILTERS(D_FaixaIdade)))
			VAR Leitura = IF(ISBLANK(Mul), "", IF(Mul > 0.5, "As mulheres são maioria nesta faixa.", "Os homens são maioria nesta faixa."))
			RETURN
			    "<div role='group' style='font-family:Segoe UI,Arial,sans-serif;padding:18px 22px;box-sizing:border-box;color:#1D1E21;background:#FFFFFF;'>" & "<div style='font-size:24px;line-height:30px;font-weight:600;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Faixa de " & F & " anos", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & "<div style='font-size:18px;line-height:24px;color:#667085;margin-top:2px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Empregos em 31/12/" & [Ano_Ref], "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Empregos da faixa", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(E, "#,0", "pt-BR"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK("Peso da faixa no recorte: " & IF(ISBLANK(TotFaixa), "—", FORMAT(TotFaixa, "0.0%", "pt-BR"))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Peso da faixa no recorte: " & IF(ISBLANK(TotFaixa), "—", FORMAT(TotFaixa, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#7F56D9;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Mulheres na faixa (recorte)", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(Mul), "—", FORMAT(Mul, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(NOT(SELECTEDVALUE(D_Cnae[setor_afl]) = "Sim"), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#F58220;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Mulheres na faixa · AFL", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(MulA), "—", FORMAT(MulA, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Mulheres na faixa · Comparáveis", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(MulC), "—", FORMAT(MulC, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(Leitura = "", "", "<div style='margin-top:14px;padding:9px 12px;border-left:4px solid #F58220;border-radius:0 6px 6px 0;background:#FDF7F1;font-size:18px;line-height:25px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Leitura, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>"
		displayFolder: HTML\Tooltips de gráficos
		lineageTag: 7e67da07-1d3c-4d3e-8a8b-f1d914c1b36f

	/// Tooltip da ocupação (CBO): empregos, peso no recorte, mulheres e remuneração média.
	measure Tip_CBO_HTML =
			VAR O = SELECTEDVALUE(F_rais[cbo_2002])
			VAR E = [Empregos_Ref]
			VAR Peso = DIVIDE(E, CALCULATE([Empregos_Ref], REMOVEFILTERS(F_rais[cbo_2002])))
			VAR Mul = [Perf_Mulheres]
			VAR R = [Remuneracao_Media_Ref]
			VAR RGeral = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(F_rais[cbo_2002]))
			VAR Razao = DIVIDE(R, RGeral)
			VAR Leitura = IF(ISBLANK(Razao), "", IF(Razao >= 1, "Paga acima da média do recorte.", "Paga abaixo da média do recorte."))
			RETURN
			    "<div role='group' style='font-family:Segoe UI,Arial,sans-serif;padding:18px 22px;box-sizing:border-box;color:#1D1E21;background:#FFFFFF;'>" & "<div style='font-size:24px;line-height:30px;font-weight:600;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(O, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & "<div style='font-size:18px;line-height:24px;color:#667085;margin-top:2px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Empregos em 31/12/" & [Ano_Ref], "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Empregos", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(E, "#,0", "pt-BR"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK("Peso no recorte: " & IF(ISBLANK(Peso), "—", FORMAT(Peso, "0.0%", "pt-BR"))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Peso no recorte: " & IF(ISBLANK(Peso), "—", FORMAT(Peso, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#7F56D9;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Mulheres", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(Mul), "—", FORMAT(Mul, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#17B26A;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Remuneração média de dezembro", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(R), "—", "R$ " & FORMAT(R, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK(IF(ISBLANK(Razao), BLANK(), FORMAT(Razao, "0%", "pt-BR") & " da média do recorte")), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(Razao), BLANK(), FORMAT(Razao, "0%", "pt-BR") & " da média do recorte"), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(Leitura = "", "", "<div style='margin-top:14px;padding:9px 12px;border-left:4px solid #F58220;border-radius:0 6px 6px 0;background:#FDF7F1;font-size:18px;line-height:25px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Leitura, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>"
		displayFolder: HTML\Tooltips de gráficos
		lineageTag: b904e64d-365e-4d5e-a1b5-a0984aa15133

	/// Tooltip do ano na série de remuneração: média e mediana do AFL e dos Comparáveis.
	measure Tip_Rem_Ano_HTML =
			VAR A = SELECTEDVALUE(D_Calendario[Ano])
			VAR MA = [Remuneracao_Media_Ref_AFL]
			VAR MdA = [Remuneracao_Mediana_Ref_AFL]
			VAR MC = [Remuneracao_Media_Ref_Comparavel]
			VAR MdC = [Remuneracao_Mediana_Ref_Comparavel]
			VAR MS = [Remuneracao_Media_Ref]
			VAR Razao = DIVIDE(MA, MC)
			VAR PaginaAFL = SELECTEDVALUE(D_Cnae[setor_afl]) = "Sim"
			VAR Leitura = IF(ISBLANK(Razao), "", "O AFL pagou, em média, " & FORMAT(Razao, "0%", "pt-BR") & " do que pagaram os Comparáveis. Valores nominais: não descontam a inflação.")
			RETURN
			    "<div role='group' style='font-family:Segoe UI,Arial,sans-serif;padding:18px 22px;box-sizing:border-box;color:#1D1E21;background:#FFFFFF;'>" & "<div style='font-size:24px;line-height:30px;font-weight:600;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Dezembro de " & A, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & "<div style='font-size:18px;line-height:24px;color:#667085;margin-top:2px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Remuneração de dezembro, R$ nominais", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#F58220;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("AFL · média", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(MA), "—", "R$ " & FORMAT(MA, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK("Mediana " & IF(ISBLANK(MdA), "—", "R$ " & FORMAT(MdA, "#,0", "pt-BR"))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Mediana " & IF(ISBLANK(MdA), "—", "R$ " & FORMAT(MdA, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Comparáveis · média", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(MC), "—", "R$ " & FORMAT(MC, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK("Mediana " & IF(ISBLANK(MdC), "—", "R$ " & FORMAT(MdC, "#,0", "pt-BR"))), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Mediana " & IF(ISBLANK(MdC), "—", "R$ " & FORMAT(MdC, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(NOT PaginaAFL, "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#98A2B3;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Seleção atual · média", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(MS), "—", "R$ " & FORMAT(MS, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(Leitura = "", "", "<div style='margin-top:14px;padding:9px 12px;border-left:4px solid #F58220;border-radius:0 6px 6px 0;background:#FDF7F1;font-size:18px;line-height:25px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Leitura, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>"
		displayFolder: HTML\Tooltips de gráficos
