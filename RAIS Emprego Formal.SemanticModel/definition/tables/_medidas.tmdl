	/// Indicador escolhido no AFL da UF (para o tooltip do ranking de UFs do mercado).
	measure Ind_UF_AFL_Dica = CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL")
		formatString: 0.0%
