	/// Índice de empregos do Comparável (base 100 = primeiro ano do trecho), trecho 2022 em diante; BLANK fora do trecho.
	measure Emp_Indice_Comp_Pos =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Fim = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
			VAR Base = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			RETURN IF(NOT ISBLANK(A) && A >= 2022 && Base > 0, DIVIDE(Fim, Base) * 100)
		formatString: 0.0
