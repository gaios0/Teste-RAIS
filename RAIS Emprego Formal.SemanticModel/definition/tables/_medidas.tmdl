			VAR R2C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), D_Raca[grupo_raca] = "Amarela", D_Raca[declarada] = "Sim"), DeclC)
