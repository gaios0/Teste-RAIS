			 & "<div style='margin-top:10px;font-size:19px;line-height:27px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("A mediana é o valor do meio: metade dos empregados ganha menos que ela e metade ganha mais. A média soma todas as remunerações e divide pelo número de empregados; costuma ser maior, porque poucos salários muito altos a puxam para cima.", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>"
			 & "<div style='margin-top:16px;padding:12px 16px;background:#FDF7F1;border-left:4px solid #F58220;border-radius:6px;font-size:19px;line-height:28px;'><b>Exemplo</b><br>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(Med), "Para esta combinação de filtros a mediana não está disponível; ela existe para setor, UF, sexo e escolaridade.", "Em dezembro de " & A & ", metade ganhava até R$ " & FORMAT(Med, "#,0", "pt-BR") & "; a média foi R$ " & FORMAT(Media, "#,0", "pt-BR") & "."), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;"), "[[br]]", "<br>") & "</div>"
			 & "<div style='margin-top:14px;font-size:16px;line-height:22px;color:#667085;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Valores nominais (sem correção pela inflação). Remuneração de dezembro.", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>"
