			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK(Peso), "—", FORMAT(Peso, "0.0%", "pt-BR")) & "</div>"
			        & "<div style='margin-top:3px;font-size:22px;line-height:26px;white-space:nowrap;text-overflow:ellipsis;color:" & "#434446" & ";overflow:hidden;'>" & "de todo o emprego formal" & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #434446;border-radius:6px;background:#F2F4F7;color:#1D1E21;font-size:20px;line-height:26px;font-weight:600;'>" & IF(ISBLANK(PesoComp), "—", FORMAT(PesoComp, "0.0%", "pt-BR")) & " do AFL + comparáveis <span style='font-weight:400;font-size:17px;color:#434446;'>· ref.</span></span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Empregos\KPIs
		lineageTag: cc972583-7e7e-4c50-a010-f955c4444564

	/// KPI de crescimento médio ao ano no trecho (página AFL), com referência dos comparáveis.
	measure KPI_Cresc_AFL_HTML =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Cresc = [Empregos_Cresc_Medio_Ano]
			VAR CrescComp = [Empregos_Cresc_Medio_Ano_Comparavel]
			VAR CrescAfl = [Empregos_Cresc_Medio_Ano_AFL]
			VAR Seq = [Emp_Sequencia_Altas_AFL]
			VAR Linha = IF(A > I, IF(Seq >= 2, Seq & " altas seguidas", IF(Seq = 1, "alta no último ano", "queda no último ano")), "Primeiro ano do trecho: ainda sem crescimento a medir")
			RETURN
			    "<div role='group' aria-label='KPI de crescimento médio ao ano' style='width:100%;height:172px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='font-size:24px;line-height:28px;font-weight:600;color:#434446;white-space:nowrap;'>" & "Crescimento médio ao ano desde " & I & "</div>"
			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK(Cresc), "—", IF(ISBLANK(Cresc), "—", IF(Cresc > 0, "+", IF(Cresc < 0, "−", "")) & FORMAT(ABS(Cresc), "0.0%", "pt-BR"))) & "</div>"
			        & "<div style='margin-top:3px;font-size:22px;line-height:26px;white-space:nowrap;text-overflow:ellipsis;color:" & "#434446" & ";overflow:hidden;'>" & Linha & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #434446;border-radius:6px;background:#F2F4F7;color:#1D1E21;font-size:20px;line-height:26px;font-weight:600;'>Comparáveis " & IF(ISBLANK(CrescComp), "—", IF(CrescComp > 0, "+", IF(CrescComp < 0, "−", "")) & FORMAT(ABS(CrescComp), "0.0%", "pt-BR")) & " <span style='font-weight:400;font-size:17px;color:#434446;'>· ref.</span></span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Empregos\KPIs
		lineageTag: df5fa4b0-819e-4098-89bd-6e1cbf90b0cf

	/// KPI de crescimento médio ao ano no trecho (página Todos os setores), com chips AFL e comparáveis.
	measure KPI_Cresc_Total_HTML =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Cresc = [Empregos_Cresc_Medio_Ano]
			VAR CrescComp = [Empregos_Cresc_Medio_Ano_Comparavel]
			VAR CrescAfl = [Empregos_Cresc_Medio_Ano_AFL]
			VAR Seq = [Emp_Sequencia_Altas_AFL]
			VAR Linha = IF(A > I, "por ano, de " & I & " a " & A, "Primeiro ano do trecho: ainda sem crescimento a medir")
			RETURN
			    "<div role='group' aria-label='KPI de crescimento médio ao ano' style='width:100%;height:172px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='font-size:24px;line-height:28px;font-weight:600;color:#434446;white-space:nowrap;'>" & "Crescimento médio ao ano desde " & I & "</div>"
			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK(Cresc), "—", IF(ISBLANK(Cresc), "—", IF(Cresc > 0, "+", IF(Cresc < 0, "−", "")) & FORMAT(ABS(Cresc), "0.0%", "pt-BR"))) & "</div>"
			        & "<div style='margin-top:3px;font-size:22px;line-height:26px;white-space:nowrap;text-overflow:ellipsis;color:" & "#434446" & ";overflow:hidden;'>" & Linha & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #F58220;border-radius:6px;background:#FDF7F1;color:#B86218;font-size:20px;line-height:26px;font-weight:600;'>AFL " & IF(ISBLANK(CrescAfl), "—", IF(CrescAfl > 0, "+", IF(CrescAfl < 0, "−", "")) & FORMAT(ABS(CrescAfl), "0.0%", "pt-BR")) & "</span>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #434446;border-radius:6px;background:#F2F4F7;color:#1D1E21;font-size:20px;line-height:26px;font-weight:600;'>Comparáveis " & IF(ISBLANK(CrescComp), "—", IF(CrescComp > 0, "+", IF(CrescComp < 0, "−", "")) & FORMAT(ABS(CrescComp), "0.0%", "pt-BR")) & " <span style='font-weight:400;font-size:17px;color:#434446;'>· ref.</span></span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Empregos\KPIs
