	/// Linha de contexto da página Empregos · Todos os setores.
	measure Contexto_Emp_Total =
			VAR A = [Ano_Ref]
			VAR TemUF = ISFILTERED(D_UF[uf])
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Local = IF(NOT TemUF || NUF = COUNTROWS(ALL(D_UF[uf])), "Brasil", IF(NUF = 1, SELECTEDVALUE(D_UF[estado]), NUF & " UFs"))
			VAR Sexo = IF(ISFILTERED(D_Sexo[sexo]), CONCATENATEX(VALUES(D_Sexo[sexo]), D_Sexo[sexo], ", "), "")
			VAR Esc = IF(ISFILTERED(D_Escolaridade[escolaridade_agrupada]), CONCATENATEX(VALUES(D_Escolaridade[escolaridade_agrupada]), D_Escolaridade[escolaridade_agrupada], ", "), "")
			VAR Raca = IF(ISFILTERED(D_Raca[raca_cor]), CONCATENATEX(VALUES(D_Raca[raca_cor]), D_Raca[raca_cor], ", "), "")
			VAR Setor = IF(ISFILTERED(D_Comparavel[comparavel_AFL]), "setores comparáveis ao AFL", "todos os setores")
			VAR Partes = FILTER(UNION(ROW("@o", 1, "@t", "31/12/" & A), ROW("@o", 2, "@t", Local), ROW("@o", 3, "@t", Setor), ROW("@o", 4, "@t", Sexo),
			    ROW("@o", 5, "@t", Esc), ROW("@o", 6, "@t", Raca), ROW("@o", 7, "@t", "RAIS (" & IF(A >= 2022, "eSocial", "declaratória") & ")")), NOT ISBLANK([@t]) && [@t] <> "")
			VAR Texto = CONCATENATEX(Partes, [@t], " · ", [@o], ASC)
			RETURN IF(ISBLANK(A), "", Texto)
		isHidden
		displayFolder: Empregos\Apoio
		lineageTag: bef76d55-d439-43f0-8c0a-4ed79a97f8d8

	/// Linha de contexto da página Empregos · AFL.
	measure Contexto_Emp_AFL =
			VAR A = [Ano_Ref]
			VAR TemUF = ISFILTERED(D_UF[uf])
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Local = IF(NOT TemUF || NUF = COUNTROWS(ALL(D_UF[uf])), "Brasil", IF(NUF = 1, SELECTEDVALUE(D_UF[estado]), NUF & " UFs"))
			VAR Sexo = IF(ISFILTERED(D_Sexo[sexo]), CONCATENATEX(VALUES(D_Sexo[sexo]), D_Sexo[sexo], ", "), "")
			VAR Esc = IF(ISFILTERED(D_Escolaridade[escolaridade_agrupada]), CONCATENATEX(VALUES(D_Escolaridade[escolaridade_agrupada]), D_Escolaridade[escolaridade_agrupada], ", "), "")
			VAR Raca = IF(ISFILTERED(D_Raca[raca_cor]), CONCATENATEX(VALUES(D_Raca[raca_cor]), D_Raca[raca_cor], ", "), "")
			VAR Setor = IF(ISFILTERED(D_AflAtividade[nome]) && COUNTROWS(VALUES(D_AflAtividade[nome])) < COUNTROWS(ALL(D_AflAtividade[nome])), CONCATENATEX(VALUES(D_AflAtividade[nome]), D_AflAtividade[nome], ", "), "alimentação fora do lar (AFL)")
			VAR Partes = FILTER(UNION(ROW("@o", 1, "@t", "31/12/" & A), ROW("@o", 2, "@t", Local), ROW("@o", 3, "@t", Setor), ROW("@o", 4, "@t", Sexo),
			    ROW("@o", 5, "@t", Esc), ROW("@o", 6, "@t", Raca), ROW("@o", 7, "@t", "RAIS (" & IF(A >= 2022, "eSocial", "declaratória") & ")")), NOT ISBLANK([@t]) && [@t] <> "")
			VAR Texto = CONCATENATEX(Partes, [@t], " · ", [@o], ASC)
			RETURN IF(ISBLANK(A), "", Texto)
		isHidden
		displayFolder: Empregos\Apoio
		lineageTag: 237d2889-3578-4247-9d4c-2c7af53ba071

	/// Manchete da página Empregos · Todos os setores.
	measure Manchete_Emp_Total_HTML =
			VAR A = [Ano_Ref]
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Prep = IF(NOT ISFILTERED(D_UF[uf]) || NUF = COUNTROWS(ALL(D_UF[uf])), "No Brasil", IF(NUF = 1, "Em " & SELECTEDVALUE(D_UF[estado]), "Nas " & NUF & " UFs escolhidas"))
			VAR Valor = [Empregos_Ref]
			VAR Var = [Empregos_Var]
			VAR VarPct = [Empregos_Var_Pct]
			VAR Seq = [Emp_Sequencia_Altas_AFL]
			VAR Contexto = [Contexto_Emp_Total]
			VAR Pos = [Emp_Posicao_AFL_Divisao]
			VAR Divs = [Emp_Total_Divisoes]
			VAR Texto = Prep & ", o emprego formal fechou " & A & " com " & FORMAT(Valor, "#,0", "pt-BR") & " vínculos" & IF(ISBLANK(Pos), "", "; o AFL é a " & Pos & "ª maior divisão entre " & Divs)
			VAR Valido = NOT ISBLANK(A) && NOT ISBLANK(Valor)
			RETURN
			    IF(NOT Valido,
			        "<div role='text' style='width:100%;height:118px;font-family:Segoe UI,Arial,sans-serif;font-size:24px;color:#434446;'>Não há dados para os filtros selecionados.</div>",
			        "<div role='group' aria-label='Resumo do emprego formal' style='width:100%;height:118px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			            & "<div style='height:48px;display:flex;align-items:center;white-space:nowrap;overflow:hidden;'><span style='min-width:0;font-size:36px;line-height:42px;font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Texto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span></div>"
			            & "<div style='height:30px;margin:4px 0 0;font-size:24px;line-height:30px;color:#434446;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Contexto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>"
			        & "</div>")
		displayFolder: HTML\Empregos
		lineageTag: 51e632d8-9028-4e8b-bfa1-6e2097ea99cb

	/// Manchete da página Empregos · AFL.
	measure Manchete_Emp_AFL_HTML =
			VAR A = [Ano_Ref]
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Prep = IF(NOT ISFILTERED(D_UF[uf]) || NUF = COUNTROWS(ALL(D_UF[uf])), "No Brasil", IF(NUF = 1, "Em " & SELECTEDVALUE(D_UF[estado]), "Nas " & NUF & " UFs escolhidas"))
			VAR Valor = [Empregos_Ref]
			VAR Var = [Empregos_Var]
			VAR VarPct = [Empregos_Var_Pct]
			VAR Seq = [Emp_Sequencia_Altas_AFL]
			VAR Contexto = [Contexto_Emp_AFL]
			VAR Fecho = SWITCH(TRUE(), ISBLANK(Var), IF(A = 2022, "primeiro ano da fonte eSocial", "primeiro ano da série"),
			    Var > 0, IF(Seq >= 2, Seq & "ª alta seguida", "alta de " & IF(ISBLANK(VarPct), "—", FORMAT(VarPct, "0.0%", "pt-BR"))), Var < 0, "queda de " & IF(ISBLANK(ABS(VarPct)), "—", FORMAT(ABS(VarPct), "0.0%", "pt-BR")) & " sobre " & (A - 1), "estável")
			VAR Texto = Prep & ", o AFL fechou " & A & " com " & FORMAT(Valor, "#,0", "pt-BR") & " empregos formais: " & Fecho
			VAR Valido = NOT ISBLANK(A) && NOT ISBLANK(Valor)
			RETURN
			    IF(NOT Valido,
			        "<div role='text' style='width:100%;height:118px;font-family:Segoe UI,Arial,sans-serif;font-size:24px;color:#434446;'>Não há dados para os filtros selecionados.</div>",
			        "<div role='group' aria-label='Resumo do emprego formal' style='width:100%;height:118px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			            & "<div style='height:48px;display:flex;align-items:center;white-space:nowrap;overflow:hidden;'><span style='min-width:0;font-size:36px;line-height:42px;font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Texto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span></div>"
			            & "<div style='height:30px;margin:4px 0 0;font-size:24px;line-height:30px;color:#434446;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Contexto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>"
			        & "</div>")
		displayFolder: HTML\Empregos
		lineageTag: 5cf4bb1f-0638-4334-8ae9-a731dd810839

	/// Título do gráfico de série (índice): crescimento desde o início do trecho, AFL × comparáveis.
	measure Titulo_Emp_Serie_HTML =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR Afl = [Empregos_Ref_AFL]
			VAR Comp = [Empregos_Ref_Comparavel]
			VAR AflI = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			VAR CompI = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I)
			VAR CAfl = DIVIDE(Afl, AflI) - 1
			VAR CComp = DIVIDE(Comp, CompI) - 1
			VAR Afl19 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2019)
			VAR Afl20 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2020)
			VAR Comp19 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2019)
			VAR Comp20 = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = 2020)
			VAR L1 = IF(ISBLANK(A), "Sem dados para os filtros escolhidos", IF(A <= I, I & " é o primeiro ano do trecho: ainda não há crescimento a comparar",
			    "Desde " & I & ", o emprego do AFL cresceu " & IF(ISBLANK(CAfl), "—", FORMAT(CAfl, "0.0%", "pt-BR")) & " e o dos comparáveis, " & IF(ISBLANK(CComp), "—", FORMAT(CComp, "0.0%", "pt-BR"))))
			VAR L2 = IF(ISBLANK(A), "", IF(A >= 2022, "Índice de empregos em 31/12, base 100 = 31/12/" & I & ". 2021 e os anos anteriores ficam no trecho anterior (nova fonte: eSocial)",
			    "Índice de empregos em 31/12, base 100 = 31/12/" & I & IF(Afl19 > 0 && Afl20 > 0 && Comp19 > 0, ". Em 2020 o AFL perdeu " & IF(ISBLANK(ABS(DIVIDE(Afl20, Afl19) - 1)), "—", FORMAT(ABS(DIVIDE(Afl20, Afl19) - 1), "0.0%", "pt-BR")) & " dos empregos; os comparáveis, " & IF(ISBLANK(ABS(DIVIDE(Comp20, Comp19) - 1)), "—", FORMAT(ABS(DIVIDE(Comp20, Comp19) - 1), "0.0%", "pt-BR")), "")))
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#F58220" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Empregos\Títulos
		lineageTag: c57a3a11-7a7a-459f-a275-33024d92d08d

	/// Tabela de contratos: AFL × Comparáveis, em % dos empregos de 31/12 do ano de referência (categorias exclusivas, na ordem intermitente, aprendiz, parcial, CLT, prazo determinado).
	measure Emp_Contratos_HTML =
			VAR A = [Ano_Ref]
			VAR TotA = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)
