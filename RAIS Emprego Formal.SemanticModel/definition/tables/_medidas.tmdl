	/// Remuneracao_Mediana_Ref só do grupo AFL, independente do filtro de setores da página.
	measure Remuneracao_Mediana_Ref_AFL = CALCULATE([Remuneracao_Mediana_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL")
		formatString: #,0.00
