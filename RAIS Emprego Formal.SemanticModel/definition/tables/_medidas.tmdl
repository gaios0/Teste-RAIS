			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A) && A >= 2022, CALCULATE([Remuneracao_Media], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A))
		formatString: #,0
		displayFolder: Quanto ganha\Séries
		lineageTag: 08d74e2b-3d66-43f3-9df5-4f70daebad4a

	/// Mediana da remuneração de dezembro do Comparáveis, trecho Pos; BLANK fora do trecho ou quando a mediana não existe para os filtros.
	measure Rem_Mediana_Comp_Pos =
			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A) && A >= 2022, [Remuneracao_Mediana_Ref_Comparavel])
		formatString: #,0
		displayFolder: Quanto ganha\Séries
		lineageTag: e0454f47-490d-42ce-9117-3204d25daf7e

	/// Razão da remuneração média (mulheres ÷ homens) no contexto.
	measure Rem_Razao_Sexo =
			VAR A = [Ano_Ref]
			VAR Fora = ISBLANK(A) || (SELECTEDVALUE(D_Escolaridade[escolaridade_agrupada]) IN {"< 1 ano de estudo", "Ignorado/Faltante"})
			VAR Num = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_Sexo), D_Sexo[sexo] = "Mulher")
			VAR Den = CALCULATE([Remuneracao_Media_Ref], REMOVEFILTERS(D_Sexo), D_Sexo[sexo] = "Homem")
			RETURN IF(Fora, BLANK(), DIVIDE(Num, Den))
		formatString: 0%
		displayFolder: Quanto ganha\Razões
		lineageTag: 6872217d-043a-49f7-81e5-caef207b7c88

	/// Razão da remuneração média (mulheres ÷ homens) no contexto do AFL.
	measure Rem_Razao_Sexo_AFL = CALCULATE([Rem_Razao_Sexo], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL")
