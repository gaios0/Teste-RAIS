			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK(Cresc), "—", IF(ISBLANK(Cresc), "—", IF(Cresc > 0, "+", IF(Cresc < 0, "−", "")) & FORMAT(ABS(Cresc), "0.0%", "pt-BR"))) & "</div>"
			        & "<div style='margin-top:3px;font-size:22px;line-height:26px;color:" & "#434446" & ";white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & Linha & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #F58220;border-radius:6px;background:#FDF7F1;color:#B86218;font-size:20px;line-height:26px;font-weight:600;'>AFL " & IF(ISBLANK(CrescAfl), "—", IF(CrescAfl > 0, "+", IF(CrescAfl < 0, "−", "")) & FORMAT(ABS(CrescAfl), "0.0%", "pt-BR")) & "</span>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #434446;border-radius:6px;background:#F2F4F7;color:#1D1E21;font-size:20px;line-height:26px;font-weight:600;'>Comparáveis " & IF(ISBLANK(CrescComp), "—", IF(CrescComp > 0, "+", IF(CrescComp < 0, "−", "")) & FORMAT(ABS(CrescComp), "0.0%", "pt-BR")) & " <span style='font-weight:400;font-size:17px;color:#434446;'>· ref.</span></span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Empregos\KPIs
