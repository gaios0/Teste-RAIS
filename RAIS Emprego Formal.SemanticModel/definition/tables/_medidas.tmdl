	/// KPI de remuneração mediana de dezembro, com média, salários mínimos e chips.
	measure KPI_Mediana_Total_HTML =
			VAR Med = [Remuneracao_Mediana_Ref]
			VAR Media = [Remuneracao_Media_Ref]
			VAR SM = [Remuneracao_Media_SM_Ref]
			VAR MedAFL = [Remuneracao_Mediana_Ref_AFL]
			VAR MedComp = [Remuneracao_Mediana_Ref_Comparavel]
			RETURN
			    "<div role='group' aria-label='KPI de remuneração mediana' style='width:100%;height:172px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='font-size:24px;line-height:28px;font-weight:600;color:#434446;white-space:nowrap;'>" & "Remuneração mediana de dezembro" & "</div>"
			        & "<div style='margin-top:2px;font-size:53px;line-height:58px;font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap;'>" & IF(ISBLANK(Med), "—", "R$ " & FORMAT(Med, "#,0", "pt-BR")) & "</div>"
			        & "<div style='margin-top:3px;font-size:22px;line-height:26px;white-space:nowrap;text-overflow:ellipsis;color:" & "#434446" & ";overflow:hidden;'>" & IF(ISBLANK(Med), "mediana só existe para setor, UF, sexo e escolaridade", "média R$ " & FORMAT(Media, "#,0", "pt-BR") & " · " & FORMAT(SM, "0.00", "pt-BR") & " salário mínimo") & "</div>" & "<div style='display:flex;gap:8px;margin-top:3px;white-space:nowrap;'>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #F58220;border-radius:6px;background:#FDF7F1;color:#B86218;font-size:20px;line-height:26px;font-weight:600;'>AFL " & IF(ISBLANK(MedAFL), "—", "R$ " & FORMAT(MedAFL, "#,0", "pt-BR")) & "</span>" & "<span style='display:inline-block;padding:1px 9px;border:1px solid #434446;border-radius:6px;background:#F2F4F7;color:#1D1E21;font-size:20px;line-height:26px;font-weight:600;'>Comparáveis " & IF(ISBLANK(MedComp), "—", "R$ " & FORMAT(MedComp, "#,0", "pt-BR")) & " <span style='font-weight:400;font-size:17px;color:#434446;'>· ref.</span></span>" & "</div>"
			        & "</div>"
		displayFolder: HTML\Quanto ganha\KPIs
		lineageTag: 601e9975-09bd-4c4e-a201-b6de0f10c9bc

