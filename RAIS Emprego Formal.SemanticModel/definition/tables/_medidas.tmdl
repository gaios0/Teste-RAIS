	/// Peso do AFL nos empregos comparáveis da UF: AFL ÷ (AFL + comparáveis).
	measure Emp_UF_Peso_AFL = DIVIDE([Empregos_Ref_AFL], [Empregos_Ref_AFL] + [Empregos_Ref_Comparavel])
