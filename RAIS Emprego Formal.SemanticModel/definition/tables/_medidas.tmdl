	/// Manchete da página Quanto ganha · AFL.
	measure Manchete_Salario_AFL_HTML =
			VAR NUF = COUNTROWS(VALUES(D_UF[uf]))
			VAR Prep = IF(NOT ISFILTERED(D_UF[uf]) || NUF = COUNTROWS(ALL(D_UF[uf])), "No Brasil", IF(NUF = 1, "Em " & SELECTEDVALUE(D_UF[estado]), "Nas " & NUF & " UFs escolhidas"))
			VAR Med = [Remuneracao_Mediana_Ref]
			VAR Media = [Remuneracao_Media_Ref]
			VAR MedAFL = [Remuneracao_Mediana_Ref_AFL]
			VAR MedComp = [Remuneracao_Mediana_Ref_Comparavel]
			VAR A = [Ano_Ref]
			VAR Texto = Prep & ", metade do AFL ganhava até R$ " & FORMAT(MedAFL, "#,0", "pt-BR") & " em dez/" & A & ": " & FORMAT(DIVIDE(MedAFL, MedComp), "0%", "pt-BR") & " da mediana dos Comparáveis"
			VAR Contexto = [Contexto_Emp_AFL] & " · valores nominais"
			VAR Valido = NOT ISBLANK([Ano_Ref]) && NOT ISBLANK([Empregos_Ref])
			RETURN
			    IF(NOT Valido,
			        "<div role='text' style='width:100%;height:118px;font-family:Segoe UI,Arial,sans-serif;font-size:24px;color:#434446;'>Não há dados para os filtros selecionados.</div>",
			        "<div role='group' aria-label='Remuneração dos empregados' style='width:100%;height:118px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			            & "<div style='height:48px;display:flex;align-items:center;white-space:nowrap;overflow:hidden;'><span style='min-width:0;font-size:36px;line-height:42px;font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Texto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span></div>"
			            & "<div style='height:30px;margin:4px 0 0;font-size:24px;line-height:30px;color:#434446;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Contexto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>"
			        & "</div>")
		displayFolder: HTML\Quanto ganha
		lineageTag: fb799531-0d36-402b-9890-c51fe72903e1

	/// Título da série de remuneração: média do AFL como % da média dos Comparáveis no início e no fim do trecho.
	measure Titulo_Rem_Serie_HTML =
			VAR A = [Ano_Ref]
			VAR I = [Ano_Inicio_Trecho]
			VAR R0 = DIVIDE(CALCULATE([Remuneracao_Media], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I), CALCULATE([Remuneracao_Media], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = I))
			VAR R1 = DIVIDE(CALCULATE([Remuneracao_Media], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A), CALCULATE([Remuneracao_Media], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A))
			VAR L1 = IF(ISBLANK(A), "Sem dados para os filtros escolhidos", IF(A <= I, I & " é o primeiro ano do trecho", "A média do AFL foi de " & FORMAT(R0, "0%", "pt-BR") & " para " & FORMAT(R1, "0%", "pt-BR") & " da média dos Comparáveis entre " & I & " e " & A))
			VAR L2 = IF(ISBLANK(A), "", "Remuneração de dezembro em R$ nominais (linha cheia = média, tracejada = mediana). 2021 e 2022 não se comparam (eSocial)")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#F58220" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quanto ganha\Títulos
		lineageTag: 7c453282-1398-4997-99f4-4d7c5298d526

	/// Título da remuneração por escolaridade: quanto o AFL paga em relação aos Comparáveis com superior completo.
	measure Titulo_Rem_Esc_HTML =
			VAR Sup = CALCULATE(DIVIDE([Remuneracao_Media_Ref_AFL], [Remuneracao_Media_Ref_Comparavel]), KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] = "Superior Completo"))
			VAR Med = CALCULATE(DIVIDE([Remuneracao_Media_Ref_AFL], [Remuneracao_Media_Ref_Comparavel]), KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] = "Médio Completo"))
			VAR L1 = IF(ISBLANK(Sup), "Sem dados para os filtros escolhidos", "Com superior completo, o AFL paga " & FORMAT(Sup, "0%", "pt-BR") & " da média dos Comparáveis")
			VAR L2 = IF(ISBLANK(Sup), "", "Com ensino médio completo: " & FORMAT(Med, "0%", "pt-BR") & ". Remuneração média de dezembro (R$ nominais)")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#1D1E21" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quanto ganha\Títulos
		lineageTag: 4eb8f706-c565-413d-ad2d-6b8816109b27

	/// Título das razões por sexo e cor, AFL × Comparáveis.
	measure Titulo_Rem_Gap_HTML =
			VAR S = [Rem_Razao_Sexo_AFL]
			VAR SC = [Rem_Razao_Sexo_Comp]
			VAR R = [Rem_Razao_Raca_AFL]
			VAR RC = [Rem_Razao_Raca_Comp]
			VAR L1 = IF(ISBLANK(S) && ISBLANK(R), "Sem dados para os filtros escolhidos", "A diferença salarial por sexo e por cor é menor no AFL do que nos Comparáveis")
			VAR L2 = IF(L1 = "Sem dados para os filtros escolhidos", "", "Sem filtro de escolaridade: mulheres ganham " & FORMAT(S, "0%", "pt-BR") & " do salário dos homens no AFL (" & FORMAT(SC, "0%", "pt-BR") & " nos Comparáveis); negros, " & FORMAT(R, "0%", "pt-BR") & " do dos brancos (" & FORMAT(RC, "0%", "pt-BR") & ")")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#1D1E21" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quanto ganha\Títulos
		lineageTag: 2387bd19-8b77-407c-b72e-4dbd8dfffe10

	/// Título das UFs: maior média e maior distância para os Comparáveis.
	measure Titulo_Rem_UF_HTML =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_UF[uf]), "@v", [Remuneracao_Media_Ref], "@r", [Rem_UF_Razao_Comp]), NOT ISBLANK([@v]))
			VAR Lider1 = TOPN(1, T, [@v], DESC, D_UF[uf], ASC)
			VAR UF = CONCATENATEX(Lider1, D_UF[uf], "")
			VAR V = MAXX(Lider1, [@v])
			VAR Pior = TOPN(1, FILTER(T, NOT ISBLANK([@r])), [@r], ASC, D_UF[uf], ASC)
			VAR UFP = CONCATENATEX(Pior, D_UF[uf], "")
			VAR RP = MAXX(Pior, [@r])
			VAR L1 = IF(COUNTROWS(T) = 0, "Sem dados para os filtros escolhidos", IF(COUNTROWS(T) = 1, UF & ": R$ " & FORMAT(V, "#,0", "pt-BR"), UF & " paga a maior média: R$ " & FORMAT(V, "#,0", "pt-BR")))
			VAR L2 = IF(COUNTROWS(T) < 2 || ISBLANK(RP), "", "Maior distância para os Comparáveis: " & UFP & " (AFL " & FORMAT(RP, "0%", "pt-BR") & " da média comparável)")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#1D1E21" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quanto ganha\Títulos
		lineageTag: 036be4e3-4305-4f26-8d2c-0ead0fefde3f

	/// Indicador escolhido nos botões (padrão: Mulheres).
	measure Ind_Atual = COALESCE(SELECTEDVALUE(D_Indicador[indicador]), "Mulheres")
		isHidden
		displayFolder: Quem contrata\Apoio
		lineageTag: 277306d9-9cbe-404e-9e3e-5c280d0903dd

	/// Nome do indicador por extenso.
	measure Ind_Rotulo = SWITCH([Ind_Atual], "Primeiro emprego", "primeiro emprego", "Mulheres", "mulheres", "Até 24 anos", "jovens até 24 anos", "55 anos ou mais", "empregados com 55 anos ou mais", "Superior", "superior (completo ou não)", "Negros", "negros (entre quem declarou cor)", "Intermitente", "contrato intermitente", "")
		isHidden
		displayFolder: Quem contrata\Apoio
		lineageTag: 04de6090-5fb9-42bc-a55e-8e9e6d861450

	/// Frase do indicador para as manchetes.
	measure Ind_Frase = SWITCH([Ind_Atual], "Primeiro emprego", "dos empregados estavam no primeiro emprego", "Mulheres", "dos empregados são mulheres", "Até 24 anos", "dos empregados têm até 24 anos", "55 anos ou mais", "dos empregados têm 55 anos ou mais", "Superior", "dos empregados têm superior (completo ou não)", "Negros", "dos empregados que declararam cor são negros", "Intermitente", "dos empregados têm contrato intermitente", "")
		isHidden
		displayFolder: Quem contrata\Apoio
		lineageTag: 6a42a23f-8e98-4d61-a6be-a4c4ecb2ead9

	/// Ano de cálculo do indicador no ranking: primeiro emprego só existe até 2021 (usa o menor entre o ano e 2021); intermitente, desde 2018.
	measure Ind_Ano =
			VAR A = [Ano_Ref]
			VAR Ind = [Ind_Atual]
			RETURN IF(ISBLANK(A), BLANK(), IF(Ind = "Primeiro emprego", MIN(A, 2021), IF(Ind = "Intermitente" && A < 2018, BLANK(), A)))
		formatString: 0
		isHidden
		displayFolder: Quem contrata\Apoio
		lineageTag: d71b47c8-1331-4fb1-9662-e286e964ba74

	/// Participação do indicador escolhido no contexto (categoria do visual, filtros e grupo), no ano do ranking.
	measure Ind_Valor_Ctx =
			VAR Ind = [Ind_Atual]
			VAR A = [Ind_Ano]
			RETURN IF(ISBLANK(A), BLANK(), SWITCH(Ind,
			    "Primeiro emprego", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(F_rais[tipo_admissao] = "Primeiro Emprego")), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "Mulheres", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Sexo[sexo] = "Mulher")), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "Até 24 anos", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_FaixaIdade[faixa_idade] IN {"14-17", "18-24"})), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "55 anos ou mais", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_FaixaIdade[faixa_idade] IN {"55-64", "65+"})), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "Superior", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] IN {"Superior Incompleto", "Superior Completo"})), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "Negros", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Raca[grupo_raca] = "Negra")), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Raca[declarada] = "Sim"))),
			    "Intermitente", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(F_rais[trabalho_intermitente] = "Sim")), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    BLANK()))
		formatString: 0.0%
		displayFolder: Quem contrata\Indicadores
		lineageTag: 237dc9ee-6f5e-4a7d-856d-36361cbcae81

	/// Participação do indicador escolhido no ano do contexto (para séries; primeiro emprego só até 2021 e intermitente desde 2018).
	measure Ind_Valor_Ano =
			VAR Ind = [Ind_Atual]
			VAR A = IF(([Ind_Atual] = "Primeiro emprego" && [Ano_Ref] > 2021) || ([Ind_Atual] = "Intermitente" && [Ano_Ref] < 2018), BLANK(), [Ano_Ref])
			RETURN IF(ISBLANK(A), BLANK(), SWITCH(Ind,
			    "Primeiro emprego", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(F_rais[tipo_admissao] = "Primeiro Emprego")), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "Mulheres", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Sexo[sexo] = "Mulher")), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "Até 24 anos", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_FaixaIdade[faixa_idade] IN {"14-17", "18-24"})), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "55 anos ou mais", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_FaixaIdade[faixa_idade] IN {"55-64", "65+"})), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "Superior", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] IN {"Superior Incompleto", "Superior Completo"})), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    "Negros", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Raca[grupo_raca] = "Negra")), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Raca[declarada] = "Sim"))),
			    "Intermitente", DIVIDE(CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(F_rais[trabalho_intermitente] = "Sim")), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A)),
			    BLANK()))
		formatString: 0.0%
		displayFolder: Quem contrata\Indicadores
		lineageTag: af0c5b67-a1cf-4930-b041-d9432f0d797e

	/// Indicador escolhido, só do AFL.
	measure Ind_Valor_AFL = CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL")
		formatString: 0.0%
		displayFolder: Quem contrata\Indicadores
		lineageTag: 115f009b-9149-414a-ae42-181997635d63

	/// Indicador escolhido, só dos Comparáveis.
	measure Ind_Valor_Comp = CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
		formatString: 0.0%
		displayFolder: Quem contrata\Indicadores
		lineageTag: a2156dbb-a572-4acd-8a1c-d175410187db

	/// Indicador escolhido ao longo dos anos, AFL, trecho Pre.
	measure Ind_Serie_AFL_Pre =
			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A) && A < 2022, CALCULATE([Ind_Valor_Ano], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"))
		formatString: 0.0%
		displayFolder: Quem contrata\Séries
		lineageTag: 700bfbaf-6c9a-4823-b403-8ebb5d7dc4de

	/// Indicador escolhido ao longo dos anos, AFL, trecho Pos.
	measure Ind_Serie_AFL_Pos =
			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A) && A >= 2022, CALCULATE([Ind_Valor_Ano], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"))
		formatString: 0.0%
		displayFolder: Quem contrata\Séries
		lineageTag: f332788c-0c3e-4710-a974-3fccaaf79483

	/// Indicador escolhido ao longo dos anos, Comparáveis, trecho Pre.
	measure Ind_Serie_Comp_Pre =
			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A) && A < 2022, CALCULATE([Ind_Valor_Ano], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável"))
		formatString: 0.0%
		displayFolder: Quem contrata\Séries
		lineageTag: 1f864d84-57cb-4a93-9242-9cfce3c27d19

	/// Indicador escolhido ao longo dos anos, Comparáveis, trecho Pos.
	measure Ind_Serie_Comp_Pos =
			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A) && A >= 2022, CALCULATE([Ind_Valor_Ano], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável"))
		formatString: 0.0%
		displayFolder: Quem contrata\Séries
		lineageTag: 75988d7b-d8f4-44e5-8c24-a4659b2773e0

	/// Indicador escolhido por divisão (item AFL = seis CNAEs); só divisões com 50.000 empregos ou mais.
	measure Ind_Valor_Div =
			VAR Nome = SELECTEDVALUE(D_Rank_Divisao[nm_divisao])
			VAR A = [Ind_Ano]
			VAR Den = IF(Nome = "AFL · conjunto de 6 CNAEs", CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A),
			    CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), KEEPFILTERS(D_Cnae[nm_divisao] = Nome), KEEPFILTERS(D_Cnae[setor_afl] = "Não"), REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A))
			VAR Val = IF(Nome = "AFL · conjunto de 6 CNAEs", CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"),
			    CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), KEEPFILTERS(D_Cnae[nm_divisao] = Nome), KEEPFILTERS(D_Cnae[setor_afl] = "Não")))
			RETURN IF(ISBLANK(Nome) || ISBLANK(A) || Den < 50000, BLANK(), Val)
		formatString: 0.0%
		displayFolder: Quem contrata\Ranking
		lineageTag: e40e1ddd-291a-4a5d-856d-5bae5b496ed8

	/// Valor do ranking: as 10 maiores divisões no indicador e sempre o AFL; as demais voltam BLANK.
	measure Ind_Divisao_Top =
			VAR EhAFL = SELECTEDVALUE(D_Rank_Divisao[nm_divisao]) = "AFL · conjunto de 6 CNAEs"
			VAR V = [Ind_Valor_Div]
			VAR R = IF(NOT ISBLANK(V), RANKX(ALLSELECTED(D_Rank_Divisao[nm_divisao]), [Ind_Valor_Div], , DESC, DENSE))
			RETURN IF(NOT ISBLANK(V) && (EhAFL || R <= 10), V)
		formatString: 0.0%
		displayFolder: Quem contrata\Ranking
		lineageTag: b76c051d-139f-4e54-a3da-f227c740b19f

	/// Cor do ranking: AFL em laranja, demais em cinza.
	measure Cor_Ind_Divisao = IF(SELECTEDVALUE(D_Rank_Divisao[nm_divisao]) = "AFL · conjunto de 6 CNAEs", "#F58220", "#DDDDDE")
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: d52b222d-ca54-46f3-8d2a-48ddceecea46

	/// Posição do AFL entre todas as divisões no indicador escolhido.
	measure Ind_Posicao_AFL =
			VAR T = FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Ind_Valor_Div]), NOT ISBLANK([@v]))
			VAR VA = MAXX(FILTER(T, [nm_divisao] = "AFL · conjunto de 6 CNAEs"), [@v])
			RETURN IF(NOT ISBLANK(VA), COUNTROWS(FILTER(T, [@v] > VA)) + 1)
		formatString: 0
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: 389abd21-4bcb-4bc4-8d8b-95b689b3ac57

	/// Quantidade de divisões com o indicador calculável.
	measure Ind_Total_Divisoes = COUNTROWS(FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Ind_Valor_Div]), NOT ISBLANK([@v])))
		formatString: 0
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: 05884b36-ee8c-45a0-adca-31b05510fcd3

	/// Nome da divisão com o maior valor do indicador.
	measure Ind_Maior_Divisao =
			VAR T = FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Ind_Valor_Div]), NOT ISBLANK([@v]) && [nm_divisao] <> "AFL · conjunto de 6 CNAEs")
			RETURN CONCATENATEX(TOPN(1, T, [@v], DESC, [nm_divisao], ASC), [nm_divisao], "")
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: 1bedd66a-6207-4dd8-a4f7-7783b6b9bb95

	/// Maior valor do indicador entre as divisões.
	measure Ind_Maior_Valor =
			VAR T = FILTER(ADDCOLUMNS(ALL(D_Rank_Divisao[nm_divisao]), "@v", [Ind_Valor_Div]), NOT ISBLANK([@v]) && [nm_divisao] <> "AFL · conjunto de 6 CNAEs")
			RETURN MAXX(T, [@v])
		formatString: 0.0%
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: 67131a5e-57c6-4d63-9ed8-b90c62918dd2

	/// Atividade do AFL com o maior valor do indicador.
	measure Ind_Atividade_Lider =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_AflAtividade[nome]), "@v", [Ind_Valor_Ctx]), NOT ISBLANK([@v]))
			RETURN CONCATENATEX(TOPN(1, T, [@v], DESC, D_AflAtividade[nome], ASC), D_AflAtividade[nome], "")
		isHidden
		displayFolder: Quem contrata\Atividades
		lineageTag: f2dba365-6068-4e88-bfe1-0e618ebf4bfc

	/// Maior valor do indicador entre as atividades do AFL.
	measure Ind_Atividade_Lider_Valor =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_AflAtividade[nome]), "@v", [Ind_Valor_Ctx]), NOT ISBLANK([@v]))
			RETURN MAXX(T, [@v])
		formatString: 0.0%
		isHidden
		displayFolder: Quem contrata\Atividades
		lineageTag: d66a4fef-1cf1-443d-8fe8-bcf9ab76862e

	/// Indicador escolhido por UF, só do AFL (10 maiores UFs; só UFs com 3 mil empregos do AFL ou mais).
	measure Ind_UF_Top =
			VAR IA = [Ind_Ano]
			VAR Den = CALCULATE([Empregos], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = IA)
			VAR V = IF(Den >= 3000, CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"))
			VAR R = IF(NOT ISBLANK(V), RANKX(ALLSELECTED(D_UF[uf]), CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"), , DESC, DENSE))
			RETURN IF(NOT ISBLANK(V) && R <= 10, V)
		formatString: 0.0%
		displayFolder: Quem contrata\UF
		lineageTag: 106e0c89-fb86-4dc2-b69c-5c6fe7b7b051

	/// Manchete da aba Quem contrata (Todos os setores).
	measure Manchete_Contrata_Total_HTML =
			VAR Pos = [Ind_Posicao_AFL]
			VAR N = [Ind_Total_Divisoes]
			VAR A = [Ind_Ano]
			VAR Afl = [Ind_Valor_AFL]
			VAR Comp = [Ind_Valor_Comp]
			VAR Rot = [Ind_Rotulo]
			VAR Frase = [Ind_Frase]
			VAR Texto = IF(ISBLANK(Pos), "O AFL não tem dados de " & Rot & " para os filtros escolhidos", "Em " & Rot & ", o AFL é o " & Pos & "º entre as " & N & " divisões: " & IF(ISBLANK(Afl), "—", FORMAT(Afl, "0.0%", "pt-BR")) & " " & Frase & ", contra " & IF(ISBLANK(Comp), "—", FORMAT(Comp, "0.0%", "pt-BR")) & " nos Comparáveis")
			VAR Contexto = "31/12/" & A & IF([Ind_Atual] = "Primeiro emprego", " (último ano com a informação)", "") & " · Brasil · divisões com " & FORMAT(50000, "#,0", "pt-BR") & " empregos ou mais · RAIS"
			VAR Valido = NOT ISBLANK(A)
			RETURN IF(NOT Valido, "<div role='text' style='width:100%;height:118px;font-family:Segoe UI,Arial,sans-serif;font-size:24px;color:#434446;'>Não há dados para os filtros selecionados.</div>",
			    "<div role='group' aria-label='Quem mais contrata' style='width:100%;height:118px;box-sizing:border-box;margin:0;padding:0;overflow:hidden;background:transparent;font-family:Segoe UI,Arial,sans-serif;color:#1D1E21;'>"
			        & "<div style='height:48px;display:flex;align-items:center;white-space:nowrap;overflow:hidden;'><span style='min-width:0;font-size:36px;line-height:42px;font-weight:600;font-variant-numeric:tabular-nums;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Texto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span></div>"
			        & "<div style='height:30px;margin:4px 0 0;font-size:24px;line-height:30px;color:#434446;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Contexto, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div></div>")
		displayFolder: HTML\Quem contrata
		lineageTag: 0d19ea9d-a0d1-43f0-9453-9e21a4b89f41

