			RETURN IF(NOT ISBLANK(A), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Raca[grupo_raca] = "Negra")))
