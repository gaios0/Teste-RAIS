	/// Valor do ranking por divisão (empregados do tipo de deficiência escolhido): representatividade OU salário médio, conforme o botão do gráfico. Mostra as 10 melhores (ou 10 piores) divisões do setor escolhido, com piso de 50.000 empregos, e sempre o AFL (fora do cálculo).
	measure Ct_Def_Valor =
			VAR Nome = SELECTEDVALUE(D_Rank_Divisao[nm_divisao])
			VAR EhAFL = Nome = "AFL · conjunto de 6 CNAEs"
			VAR Sal = COALESCE(SELECTEDVALUE(D_Ct_MetDef[metrica]), "Representatividade") = "Salário médio"
			VAR Piores = COALESCE(SELECTEDVALUE(D_Ct_Modo[modo]), "10 melhores setores") = "10 piores setores"
			VAR Setores = VALUES(D_Ct_Setor[setor])
			VAR NoSetor = CONTAINS(Setores, D_Ct_Setor[setor], SELECTEDVALUE(D_Rank_Divisao[setor_principal]))
			VAR Meu = IF(NOT ISBLANK(Nome) && (EhAFL || NoSetor), IF(Sal, [Ct_Def_Div_Sal], [Ct_Def_Div_Rep]))
			VAR Tab = FILTER(FILTER(ALL(D_Rank_Divisao[nm_divisao], D_Rank_Divisao[setor_principal]), D_Rank_Divisao[nm_divisao] <> "AFL · conjunto de 6 CNAEs" && D_Rank_Divisao[setor_principal] IN Setores), [Ct_Div_Emp] >= 50000)
			VAR Pos = IF(NOT(EhAFL) && NoSetor && NOT ISBLANK(Meu) && [Ct_Div_Emp] >= 50000,
			    IF(Piores, RANKX(Tab, IF(Sal, [Ct_Def_Div_Sal], [Ct_Def_Div_Rep]), , ASC, DENSE),
			        RANKX(Tab, IF(Sal, [Ct_Def_Div_Sal], [Ct_Def_Div_Rep]), , DESC, DENSE)))
			RETURN IF(EhAFL, Meu, IF(NOT ISBLANK(Pos) && Pos <= 10, Meu))
		displayFolder: Quem contrata\Ranking
		lineageTag: 8fc7bd63-6d76-45dc-bbc2-9a806dd3bf5e

		formatStringDefinition = IF(COALESCE(SELECTEDVALUE(D_Ct_MetDef[metrica]), "Representatividade") = "Salário médio", "\R$ #,0", "0.0%")

	/// Chave de ordenação do ranking por divisão: o valor (ou o oposto nas 10 piores). O AFL fica na posição do seu valor, junto das demais divisões.
	measure Ct_Def_Ord =
			VAR V = [Ct_Def_Valor]
			VAR Piores = COALESCE(SELECTEDVALUE(D_Ct_Modo[modo]), "10 melhores setores") = "10 piores setores"
			RETURN IF(ISBLANK(V), BLANK(), IF(Piores, -V, V))
		formatString: 0.0000
		isHidden
		displayFolder: Quem contrata\Ranking
		lineageTag: e7905960-1ad6-41bf-b6d4-ac422d720b47

	/// Valor do ranking por CNAE do AFL (empregados do tipo de deficiência escolhido): representatividade OU salário médio, conforme o botão do gráfico.
	measure Ct_Def_Valor_AFL =
			VAR Sal = COALESCE(SELECTEDVALUE(D_Ct_MetDef[metrica]), "Representatividade") = "Salário médio"
			RETURN IF(Sal, [Ct_Def_Sal], [Ct_Def_Rep])
		displayFolder: Quem contrata\Ranking
		lineageTag: 2fc06c0f-4639-444a-9084-156e29602bf8

		formatStringDefinition = IF(COALESCE(SELECTEDVALUE(D_Ct_MetDef[metrica]), "Representatividade") = "Salário médio", "\R$ #,0", "0.0%")

	/// Título do ranking por deficiência (Total); muda com os botões de tipo e de valor.
	measure Titulo_Ct_Def_Total_HTML =
			VAR Sal = COALESCE(SELECTEDVALUE(D_Ct_MetDef[metrica]), "Representatividade") = "Salário médio"
						VAR NomeTipo = SWITCH(SELECTEDVALUE(D_Ct_Def[tipo]), "Física", "física", "Auditiva", "auditiva", "Visual", "visual", "Intelectual", "intelectual", "Múltipla", "múltipla", "Reabilitado", "reabilitado", "todos os tipos")
			VAR L1 = IF(Sal, "Salário médio por divisão — deficiência", "Representatividade por divisão — deficiência")
			VAR L2 = "Tipo: " & NomeTipo & " · " & IF(Sal, "salário médio de dezembro dos empregados com esse tipo de deficiência em cada divisão (R$ nominais)", "participação do tipo no total de empregos de cada divisão") & ". Valores absolutos no tooltip."
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#F58220" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quem contrata\Títulos
		lineageTag: 4caa0b7b-380a-4e33-b6a7-2270d0b389c3

	/// Título do ranking por deficiência (AFL); muda com os botões de tipo e de valor.
	measure Titulo_Ct_Def_AFL_HTML =
			VAR Sal = COALESCE(SELECTEDVALUE(D_Ct_MetDef[metrica]), "Representatividade") = "Salário médio"
						VAR NomeTipo = SWITCH(SELECTEDVALUE(D_Ct_Def[tipo]), "Física", "física", "Auditiva", "auditiva", "Visual", "visual", "Intelectual", "intelectual", "Múltipla", "múltipla", "Reabilitado", "reabilitado", "todos os tipos")
			VAR L1 = IF(Sal, "Salário médio por CNAE do AFL — deficiência", "Representatividade por CNAE do AFL — deficiência")
			VAR L2 = "Tipo: " & NomeTipo & " · " & IF(Sal, "salário médio de dezembro dos empregados com esse tipo de deficiência em cada CNAE do AFL (R$ nominais)", "participação do tipo no total de empregos de cada CNAE do AFL") & ". Valores absolutos no tooltip."
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#F58220" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quem contrata\Títulos
		lineageTag: e9917e88-0489-4878-b73f-7423e2d234b2

	/// Tooltip do ranking por perfil (empregados do tipo de deficiência escolhido): participação, salário médio, quantidades e referência do AFL.
	measure Tip_Ct_Def_HTML =
			VAR NomeTipo = SWITCH(SELECTEDVALUE(D_Ct_Def[tipo]), "Física", "física", "Auditiva", "auditiva", "Visual", "visual", "Intelectual", "intelectual", "Múltipla", "múltipla", "Reabilitado", "reabilitado", "todos os tipos")
			VAR EhAfl = ISFILTERED(D_AflAtividade[nome])
			VAR Nome = IF(EhAfl, SELECTEDVALUE(D_AflAtividade[nome]), SELECTEDVALUE(D_Rank_Divisao[nm_divisao]))
			VAR Rep = IF(EhAfl, [Ct_Def_Rep], [Ct_Def_Div_Rep])
			VAR Sal = IF(EhAfl, [Ct_Def_Sal], [Ct_Def_Div_Sal])
			VAR Qtd = IF(EhAfl, [Ct_Def_Qtd], [Ct_Def_Div_Qtd])
			VAR Tot = IF(EhAfl, [Ct_Def_Tot], [Ct_Def_Div_Tot])
			VAR RepAfl = IF(EhAfl || Nome = "AFL · conjunto de 6 CNAEs", BLANK(), CALCULATE([Ct_Def_Rep], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"))
			VAR SalAfl = IF(EhAfl || Nome = "AFL · conjunto de 6 CNAEs", BLANK(), CALCULATE([Ct_Def_Sal], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"))
			VAR Leitura = IF(ISBLANK(RepAfl) || ISBLANK(Rep), "", "Participação em relação ao AFL: " & IF(ISBLANK(Rep) || ISBLANK(RepAfl), "", IF(Rep >= RepAfl, "+", "−") & FORMAT(ABS(Rep - RepAfl) * 100, "0.0", "pt-BR") & " p.p.") & ".")
			RETURN
			    "<div role='group' style='font-family:Segoe UI,Arial,sans-serif;padding:18px 22px;box-sizing:border-box;color:#1D1E21;background:#FFFFFF;'>" & "<div style='font-size:24px;line-height:30px;font-weight:600;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Nome, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & "<div style='font-size:18px;line-height:24px;color:#667085;margin-top:2px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Empregos em 31/12/" & [Ano_Ref] & " · deficiência: " & NomeTipo, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>" & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Tipo no total de empregos", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(Rep), "—", FORMAT(Rep, "0.0%", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & IF(ISBLANK(FORMAT(Qtd, "#,0", "pt-BR") & " de " & FORMAT(Tot, "#,0", "pt-BR") & " empregos"), "", "<div style='font-size:17px;color:#667085;margin-left:20px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(FORMAT(Qtd, "#,0", "pt-BR") & " de " & FORMAT(Tot, "#,0", "pt-BR") & " empregos", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>", "") & IF(TRUE(), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#434446;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("Salário médio (dezembro, R$ nominais)", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(Sal), "—", "R$ " & FORMAT(Sal, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(NOT ISBLANK(RepAfl), "<div style='margin-top:12px;'><div style='display:flex;justify-content:space-between;align-items:baseline;font-size:20px;'><span><span style='display:inline-block;width:12px;height:12px;border-radius:3px;background:#D97706;margin-right:8px;'></span>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE("AFL (referência)", "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span><b style='font-size:22px;font-variant-numeric:tabular-nums;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(IF(ISBLANK(RepAfl), "—", FORMAT(RepAfl, "0.0%", "pt-BR")) & " · " & IF(ISBLANK(SalAfl), "—", "R$ " & FORMAT(SalAfl, "#,0", "pt-BR")), "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</b></div>" & "</div>", "") & IF(Leitura = "", "", "<div style='margin-top:14px;padding:9px 12px;border-left:4px solid #F58220;border-radius:0 6px 6px 0;background:#FDF7F1;font-size:18px;line-height:25px;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(Leitura, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</div>") & "</div>"
		displayFolder: HTML\Tooltips de gráficos
		lineageTag: 2fe7f3d6-5515-49d3-8194-96bc4b13c206

