	/// Denominador (empregados do tipo de deficiência escolhido) da divisão da categoria; o item AFL usa os seis CNAEs.
	measure Ct_Def_Div_Tot =
			VAR Nome = SELECTEDVALUE(D_Rank_Divisao[nm_divisao])
			RETURN IF(ISBLANK(Nome), BLANK(),
			    IF(Nome = "AFL · conjunto de 6 CNAEs", CALCULATE([Ct_Def_Tot], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL"),
			        CALCULATE([Ct_Def_Tot], REMOVEFILTERS(D_GrupoSetor), KEEPFILTERS(D_Cnae[divisao_afl] = Nome), KEEPFILTERS(D_Cnae[setor_afl] = "Não"))))
		formatString: #,0
		isHidden
		displayFolder: Quem contrata\Perfil
