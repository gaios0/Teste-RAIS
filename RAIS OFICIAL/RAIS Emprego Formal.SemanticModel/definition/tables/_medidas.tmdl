	/// Indicador escolhido, só dos Comparáveis.
	measure Ind_Valor_Comp = CALCULATE([Ind_Valor_Ctx], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
		formatString: 0.0%
