			RETURN IF(NOT ISBLANK(A) && A >= 2022, CALCULATE([Remuneracao_Media], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A))
		formatString: #,0
