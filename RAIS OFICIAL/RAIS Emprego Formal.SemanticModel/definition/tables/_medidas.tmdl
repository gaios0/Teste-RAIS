	/// Representatividade: participação de empregados do nível de escolaridade escolhido no total de empregos do contexto, em 31/12 do ano de referência.
	measure Ct_Esc_Rep =
			VAR A = [Ano_Ref]
			VAR Niv = SELECTEDVALUE(D_Ct_Nivel[nivel])
