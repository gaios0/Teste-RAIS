		displayFolder: Quem trabalha\Perfil
		lineageTag: b9b31f5f-c225-455c-9462-aea7c9c3081a

	/// Pirâmide etária: % de mulheres em cada faixa sobre o total de empregos do contexto (mulheres com sinal negativo).
	measure Pir_Mulheres =
			VAR F = SELECTEDVALUE(D_FaixaIdade[faixa_idade])
			RETURN IF(ISBLANK(F) || F = "Não categorizado", BLANK(), -DIVIDE(CALCULATE([Empregos_Ref], KEEPFILTERS(D_Sexo[sexo] = "Mulher")), CALCULATE([Empregos_Ref], REMOVEFILTERS(D_FaixaIdade), D_FaixaIdade[faixa_idade] <> "Não categorizado")))
		formatString: 0.0%;0.0%;0.0%
		displayFolder: Quem trabalha\Pirâmide
		lineageTag: a5272088-91eb-4041-90cb-0b684d62100e

	/// Pir_Mulheres dos Comparáveis (referência no tooltip).
	measure Pir_Mulheres_Comp = CALCULATE([Pir_Mulheres], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
		formatString: 0.0%;0.0%;0.0%
		displayFolder: Quem trabalha\Pirâmide
		lineageTag: d4b20456-e959-46ff-9d2d-d8ec5da66236

	/// Pirâmide etária: % de homens em cada faixa sobre o total de empregos do contexto (mulheres com sinal negativo).
	measure Pir_Homens =
			VAR F = SELECTEDVALUE(D_FaixaIdade[faixa_idade])
			RETURN IF(ISBLANK(F) || F = "Não categorizado", BLANK(), DIVIDE(CALCULATE([Empregos_Ref], KEEPFILTERS(D_Sexo[sexo] = "Homem")), CALCULATE([Empregos_Ref], REMOVEFILTERS(D_FaixaIdade), D_FaixaIdade[faixa_idade] <> "Não categorizado")))
		formatString: 0.0%;0.0%;0.0%
		displayFolder: Quem trabalha\Pirâmide
		lineageTag: 2bebbb35-4a3c-4622-95ad-68b88a8894af

	/// Pir_Homens dos Comparáveis (referência no tooltip).
	measure Pir_Homens_Comp = CALCULATE([Pir_Homens], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável")
		formatString: 0.0%;0.0%;0.0%
		displayFolder: Quem trabalha\Pirâmide
		lineageTag: c05d72b8-9b1f-4a2f-93d2-bff4d0c83fed

	/// Título da pirâmide: em quantas faixas de idade as mulheres são maioria.
	measure Titulo_Pir_HTML =
			VAR T = ADDCOLUMNS(FILTER(VALUES(D_FaixaIdade[faixa_idade]), D_FaixaIdade[faixa_idade] <> "Não categorizado"), "@m", -[Pir_Mulheres], "@h", [Pir_Homens])
			VAR N = COUNTROWS(FILTER(T, NOT ISBLANK([@m]) && NOT ISBLANK([@h])))
			VAR NM = COUNTROWS(FILTER(T, [@m] > [@h]))
			VAR L1 = IF(N = 0, "Sem dados para os filtros escolhidos", IF(NM = N, "As mulheres são maioria em todas as " & N & " faixas de idade", IF(NM = 0, "Os homens são maioria em todas as " & N & " faixas de idade", "As mulheres são maioria em " & NM & " das " & N & " faixas de idade")))
			VAR L2 = IF(N = 0, "", "% do total de empregos em 31/12/" & [Ano_Ref] & ", por faixa de idade e sexo. O tooltip mostra os Comparáveis (referência)")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#7F56D9" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quem trabalha\Títulos
		lineageTag: 57513b2a-7797-43f4-adfd-6555b3c58c8e

	/// Título da escolaridade: ensino médio completo e superior, AFL × Comparáveis.
	measure Titulo_Esc_HTML =
			VAR A = [Ano_Ref]
			VAR TotA = CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] <> "Ignorado/Faltante")
			VAR E0A = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] IN {"< 1 ano de estudo", "Fundamental Incompleto", "Fundamental Completo"}), TotA)
			VAR E1A = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] IN {"Médio Incompleto"}), TotA)
			VAR E2A = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] IN {"Médio Completo"}), TotA)
			VAR E3A = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] IN {"Superior Incompleto", "Superior Completo"}), TotA)
			VAR TotC = CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] <> "Ignorado/Faltante")
			VAR E0C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] IN {"< 1 ano de estudo", "Fundamental Incompleto", "Fundamental Completo"}), TotC)
			VAR E1C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] IN {"Médio Incompleto"}), TotC)
			VAR E2C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] IN {"Médio Completo"}), TotC)
			VAR E3C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Escolaridade), D_Escolaridade[escolaridade_agrupada] IN {"Superior Incompleto", "Superior Completo"}), TotC)
			VAR L1 = IF(ISBLANK(A) || TotA = 0, "Sem dados para os filtros escolhidos", IF(ISBLANK(E2A), "—", FORMAT(E2A, "0.0%", "pt-BR")) & " dos empregados do AFL têm o ensino médio completo")
			VAR L2 = IF(ISBLANK(A) || TotA = 0, "", "Superior (completo ou não): " & IF(ISBLANK(E3A), "—", FORMAT(E3A, "0.0%", "pt-BR")) & " no AFL e " & IF(ISBLANK(E3C), "—", FORMAT(E3C, "0.0%", "pt-BR")) & " nos Comparáveis")
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#312E81" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quem trabalha\Títulos
		lineageTag: 61283622-6198-42ed-8bd6-1b7c2fb6bae5

	/// Empregos por ocupação (CBO); as 300 maiores (o gráfico mostra as primeiras e rola; o modo foco amplia).
	measure Emp_CBO_Top =
			VAR V = [Empregos_Ref]
			VAR R = IF(NOT ISBLANK(V), RANKX(ALLSELECTED(D_Cbo[ocupacao]), [Empregos_Ref], , DESC, DENSE))
			RETURN IF(NOT ISBLANK(V) && R <= 300, V)
		formatString: #,0
		displayFolder: Quem trabalha\Ocupações
		lineageTag: 00c79b45-8cee-462e-9ccc-a31b6a9db921

	/// Título das ocupações: a mais comum, seus empregos e % de mulheres.
	measure Titulo_CBO_HTML =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_Cbo[ocupacao]), "@v", [Empregos_Ref]), NOT ISBLANK([@v]))
			VAR Lider1 = TOPN(1, T, [@v], DESC, D_Cbo[ocupacao], ASC)
			VAR Nome = CONCATENATEX(Lider1, D_Cbo[ocupacao], "")
			VAR V = MAXX(Lider1, [@v])
			VAR Mul = CALCULATE([Perf_Mulheres], KEEPFILTERS(TREATAS({Nome}, D_Cbo[ocupacao])))
			VAR L1 = IF(COUNTROWS(T) = 0, "Sem dados para os filtros escolhidos", Nome & " é a ocupação mais comum: " & FORMAT(V, "#,0", "pt-BR") & " empregos")
			VAR L2 = IF(COUNTROWS(T) = 0, "", "Mulheres: " & IF(ISBLANK(Mul), "—", FORMAT(Mul, "0.0%", "pt-BR")) & " · ocupações (CBO) com mais empregos em 31/12/" & [Ano_Ref])
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#1D1E21" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quem trabalha\Títulos
		lineageTag: 34742344-73e5-4c07-b264-162b9191aff3

	/// Título de cor/raça: % de negros entre quem declarou, AFL × Comparáveis.
	measure Titulo_Raca_HTML =
			VAR A = [Ano_Ref]
			VAR DeclA = CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[declarada] = "Sim")
			VAR TotRA = CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro))
			VAR R0A = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[grupo_raca] = "Branca", D_Raca[declarada] = "Sim"), DeclA)
			VAR R1A = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[grupo_raca] = "Negra", D_Raca[declarada] = "Sim"), DeclA)
			VAR R2A = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[grupo_raca] = "Amarela", D_Raca[declarada] = "Sim"), DeclA)
			VAR R3A = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[grupo_raca] = "Indígena", D_Raca[declarada] = "Sim"), DeclA)
			VAR PriA = CALCULATE([Perf_Primeiro], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro))
			VAR IntA = CALCULATE([Perf_Intermitente], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro))
			VAR IntNA = CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "AFL", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), F_rais[trabalho_intermitente] = "Sim")
			VAR DeclC = CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[declarada] = "Sim")
			VAR TotRC = CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro))
			VAR R0C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[grupo_raca] = "Branca", D_Raca[declarada] = "Sim"), DeclC)
			VAR R1C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[grupo_raca] = "Negra", D_Raca[declarada] = "Sim"), DeclC)
			VAR R2C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[grupo_raca] = "Amarela", D_Raca[declarada] = "Sim"), DeclC)
			VAR R3C = DIVIDE(CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), D_Raca[grupo_raca] = "Indígena", D_Raca[declarada] = "Sim"), DeclC)
			VAR PriC = CALCULATE([Perf_Primeiro], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro))
			VAR IntC = CALCULATE([Perf_Intermitente], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro))
			VAR IntNC = CALCULATE([Empregos_Ref], REMOVEFILTERS(D_GrupoSetor), REMOVEFILTERS(D_Cnae), D_GrupoSetor[grupo_setor] = "Comparável", REMOVEFILTERS(D_Raca), REMOVEFILTERS(D_RacaFiltro), F_rais[trabalho_intermitente] = "Sim")
			VAR L1 = IF(ISBLANK(A) || DeclA = 0, "Sem dados para os filtros escolhidos", IF(ISBLANK(R1A), "—", FORMAT(R1A, "0.0%", "pt-BR")) & " dos empregados do AFL que declararam cor são negros")
			VAR L2 = IF(ISBLANK(A) || DeclA = 0, "", "Comparáveis: " & IF(ISBLANK(R1C), "—", FORMAT(R1C, "0.0%", "pt-BR")) & " · declararam cor: " & IF(ISBLANK(DIVIDE(DeclA, TotRA)), "—", FORMAT(DIVIDE(DeclA, TotRA), "0.0%", "pt-BR")))
			RETURN
			    "<div role='heading' aria-level='3' style='width:100%;height:100%;box-sizing:border-box;margin:0;padding:4px 56px 4px 0;display:flex;align-items:flex-start;gap:10px;background:transparent;overflow:hidden;font-family:Segoe UI,Arial,sans-serif;'>"
			        & "<span aria-hidden='true' style='flex:none;width:4px;align-self:stretch;min-height:28px;border-radius:2px;background:" & "#475467" & ";'></span>"
			        & "<span style='display:block;min-width:0;max-height:100%;overflow:hidden;font-variant-numeric:tabular-nums;'>"
			        & "<span style='display:block;font-size:24px;line-height:28px;font-weight:600;color:#1D1E21;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L1, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>"
			        & IF(L2 = "", "", "<span style='display:block;font-size:20px;line-height:26px;color:#434446;'>" & SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(L2, "&", "&amp;"), "<", "&lt;"), ">", "&gt;"), UNICHAR(34), "&quot;"), UNICHAR(39), "&#39;") & "</span>") & "</span></div>"
		displayFolder: HTML\Quem trabalha\Títulos
		lineageTag: 68eb83dd-8be6-4a0b-8dad-7246e2202a4f

	/// KPI de mulheres (% dos empregos), com chips.
	measure KPI_Mulheres_Total_HTML =
