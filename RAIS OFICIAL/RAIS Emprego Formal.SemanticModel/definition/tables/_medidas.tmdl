	/// Empregos em 31/12 do ano de referência: empregados do nível de escolaridade escolhido, no contexto.
	measure Ct_Esc_Qtd =
			VAR A = [Ano_Ref]
			VAR Niv = SELECTEDVALUE(D_Ct_Nivel[nivel])
			RETURN IF(NOT ISBLANK(A), SWITCH(Niv, "Até fundamental", CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] IN {"< 1 ano de estudo", "Fundamental Incompleto", "Fundamental Completo"})), "Médio incompleto", CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] IN {"Médio Incompleto"})), "Superior", CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] IN {"Superior Incompleto", "Superior Completo"})), "Médio completo", CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] IN {"Médio Completo"})), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] <> "Ignorado/Faltante"))))
		formatString: #,0
		isHidden
		displayFolder: Quem contrata\Perfil
		lineageTag: 3b74596f-4cc3-4ec1-a496-aca605020520

	/// Empregos em 31/12 do ano de referência que servem de denominador da participação de empregados do nível de escolaridade escolhido.
	measure Ct_Esc_Tot =
			VAR A = [Ano_Ref]
			RETURN IF(NOT ISBLANK(A), CALCULATE([Empregos], REMOVEFILTERS(D_Calendario), REMOVEFILTERS(D_Ano), D_Ano[ano] = A, KEEPFILTERS(D_Escolaridade[escolaridade_agrupada] <> "Ignorado/Faltante")))
