	/// KPI de empregados até 24 anos, com idade média.
	measure KPI_Jovens_Total_HTML =
			VAR Idade = [Perf_Idade]
			VAR IdadeI = [Perf_Idade_Inicio]
			VAR I = [Ano_Inicio_Trecho]
