	/// Maior valor do indicador entre as atividades do AFL.
	measure Ind_Atividade_Lider_Valor =
			VAR T = FILTER(ADDCOLUMNS(VALUES(D_AflAtividade[nome]), "@v", [Ind_Valor_Ctx]), NOT ISBLANK([@v]))
			RETURN MAXX(T, [@v])
		formatString: 0.0%
		isHidden
		displayFolder: Quem contrata\Atividades
		lineageTag: d66a4fef-1cf1-443d-8fe8-bcf9ab76862e

	/// Peso do AFL nos empregos comparáveis para o gráfico geográfico (UF e, ao descer, município; município só com 100 empregos do AFL ou mais).
	measure Emp_UF_Peso_Geo = IF(ISINSCOPE(D_regiao[municipio]), IF([Empregos_Ref_AFL] >= 100, [Emp_UF_Peso_AFL]), [Emp_UF_Peso_AFL])
		formatString: 0.0%
