table D_Ano
	lineageTag: 92dcca69-eb08-4847-95ff-0eda223c35eb

	column ano
		dataType: int64
		formatString: 0
		lineageTag: b12eb8d7-0559-4e19-ad34-050421a9c6b7
		summarizeBy: none
		sourceColumn: ano

		annotation SummarizationSetBy = Automatic

	partition D_Ano = m
		mode: import
		source =
				let
				    // Tabela local: a D_Ano não existe mais no Painel_RAIS. Vai de 2009 ao ano corrente, igual à D_Calendario, e cresce sozinha.
				    Anos = List.Numbers(2009, Date.Year(DateTime.LocalNow()) - 2009 + 1),
				    Tabela = Table.FromList(Anos, Splitter.SplitByNothing(), {"ano"}),
				    Tipado = Table.TransformColumnTypes(Tabela, {{"ano", Int64.Type}})
				in
				    Tipado

	annotation PBI_ResultType = Table

