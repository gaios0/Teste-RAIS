table Aux_Fonte
	lineageTag: 9bdb0be4-53e6-4524-bdb6-70ba54a6418b

	column bytes
		dataType: int64
		formatString: 0
		lineageTag: 40d915a7-7235-46b0-aec5-d92a9cff544b
		summarizeBy: sum
		sourceColumn: bytes

		annotation SummarizationSetBy = Automatic

	partition Aux_Fonte = m
		mode: import
		source =
				let
				    Base = #table(type table [url = text], {{"https://www.abrasel.com.br"}}),
				    Lido = Table.AddColumn(Base, "bytes", each Binary.Length(Web.Contents([url])), Int64.Type),
				    Resultado = Table.SelectColumns(Lido, {"bytes"})
				in
				    Resultado

	annotation PBI_ResultType = Table

